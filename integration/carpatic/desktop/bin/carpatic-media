#!/bin/sh
# carpatic-media play-pause|next|previous|stop : MPRIS media keys (any player) with a tiny OSD.
command -v playerctl >/dev/null 2>&1 || exit 0
if ! playerctl status >/dev/null 2>&1; then carpatic-osd media -1 "Nothing playing" multimedia-player-symbolic "Start a music or video app"; exit 0; fi
playerctl "$1"
t=$(playerctl metadata --format '{{ artist }} - {{ title }}' 2>/dev/null)
case $1 in play-pause) carpatic-osd media -1 "$(playerctl status 2>/dev/null)" multimedia-player-symbolic "$t" ;; next|previous) carpatic-osd media -1 "$( [ "$1" = next ] && echo Next || echo Previous)" multimedia-player-symbolic "$t" ;; esac
