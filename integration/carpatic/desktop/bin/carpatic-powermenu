#!/bin/sh
# carpatic-powermenu : keyboard-driven power menu (rofi). Lock, Sleep, Hibernate (only when ready), Log out, Restart, Shut down.
# Uses carpatic-power when installed (readiness checks, sleep hook), plain loginctl otherwise.
# Arrow keys / type to filter / Enter. Destructive entries ask once more. Esc closes.
have() { command -v "$1" >/dev/null 2>&1; }
cp_have() { have carpatic-power; }
SHARE=/usr/local/share/carpatic
theme_args() { t=$(carpatic-rofi-theme 2>/dev/null); [ -f "$t" ] && printf '%s\n' -theme "$t"; }
icon_for() { # one icon per entry (Papirus names; rofi falls back to no icon when the theme lacks one)
  case $1 in
    "Lock screen") echo system-lock-screen ;; Sleep) echo system-suspend ;; Hibernate) echo system-hibernate ;;
    "Log out"|"Yes, log out") echo system-log-out ;; Restart|"Yes, restart") echo system-reboot ;;
    "Shut down"|"Yes, shut down") echo system-shutdown ;; Cancel) echo process-stop ;; *) echo application-default-icon ;;
  esac
}
menu() { # menu PROMPT LINES [MESG]  (reads entries on stdin)
  # the window is as tall as its entries (a fixed height once hid the last one, "Shut down"): 47 px per row + padding, +50 px for a message
  items=$(cat); n=$(printf '%s\n' "$items" | wc -l); h=$((n * 47 + 30)); [ -n "${3:-}" ] && h=$((h + 50))
  ts="window { fullscreen: false; location: center; anchor: center; x-offset: 0; y-offset: 0; width: 340px; height: ${h}px; padding: 10px; border: 1px; border-radius: 14px; } mainbox { spacing: 6px; padding: 0; children: [ message, listview ]; } listview { layout: vertical; flow: vertical; columns: 1; lines: ${n}; fixed-height: false; fixed-columns: false; scrollbar: false; spacing: 2px; } entry { placeholder: \"Power\"; } inputbar { enabled: false; } element { orientation: horizontal; padding: 12px 14px; spacing: 12px; border-radius: 8px; } element-icon { size: 22px; vertical-align: 0.5; } element-text { horizontal-align: 0; } message { padding: 4px 14px 10px 14px; }"
  # shellcheck disable=SC2046
  printf '%s\n' "$items" | while IFS= read -r l; do printf '%s\0icon\037%s\n' "$l" "$(icon_for "$l")"; done |
    rofi -dmenu -i -no-custom -p "$1" ${3:+-mesg "$3"} $(theme_args) -show-icons -theme-str "$ts"
}
ready_hibernate() { cp_have && carpatic-power menu --print 2>/dev/null | grep -qx Hibernate; }
entries() {
  printf 'Lock screen\nSleep\n'
  ready_hibernate && printf 'Hibernate\n'
  printf 'Log out\nRestart\nShut down\n'
}
confirm() { # confirm VERB
  a=$(printf 'Cancel\nYes, %s\n' "$1" | menu "$1" 2 "Unsaved work will be lost.") || return 1
  [ "$a" = "Yes, $1" ]
}
do_lock()      { if have carpatic-lock; then exec carpatic-lock; else exec slock; fi; }
do_sleep()     { if cp_have; then carpatic-power sleep suspend; else loginctl suspend; fi; }
do_hibernate() { if cp_have; then carpatic-power sleep hibernate; else loginctl hibernate; fi; }
do_logout()    { if [ -n "${XDG_SESSION_ID:-}" ] && have loginctl; then loginctl terminate-session "$XDG_SESSION_ID"; else pkill -x carpatic-wm; fi; }
case ${1:-} in
  --print) entries; exit 0 ;;
  --choose) c=$2 ;;
  *) c=$(entries | menu "Power") || exit 0 ;;
esac
case $c in
  "Lock screen"|Lock) do_lock ;;
  Sleep|Suspend) do_sleep ;;
  Hibernate) do_hibernate ;;
  "Log out") [ -n "${1:-}" ] && [ "$1" = --choose ] || confirm "log out" || exit 0; do_logout ;;
  Restart) [ "${1:-}" = --choose ] || confirm "restart" || exit 0; loginctl reboot ;;
  "Shut down"|Shutdown) [ "${1:-}" = --choose ] || confirm "shut down" || exit 0; loginctl poweroff ;;
  *) exit 0 ;;
esac
