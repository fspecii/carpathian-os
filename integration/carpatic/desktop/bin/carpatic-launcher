#!/bin/sh
# carpatic-launcher : app launcher (rofi drun). Respects the configurator's rofi config when present, design-system theme otherwise.
# Shows apps by name with icons; hidden entries come from ~/.local/share/applications NoDisplay overrides.
SHARE=/usr/local/share/carpatic
export XDG_DATA_DIRS=${XDG_DATA_DIRS:-$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share}
t=$(carpatic-rofi-theme 2>/dev/null)
exec rofi -show drun -show-icons ${ROFI_ICONS:+-icon-theme "$ROFI_ICONS"} ${t:+-theme "$t"}
