#!/bin/sh
# carpatic-osd ID PERCENT TITLE ICON [BODY]  : on-screen feedback (volume, brightness...) as a dunst progress notification.
# Same ID replaces the previous bubble instead of stacking. PERCENT -1 = no bar (plain message).
id=${1:?id}; pct=${2:--1}; title=${3:-}; icon=${4:-dialog-information}; body=${5:-}
command -v notify-send >/dev/null 2>&1 || exit 0
[ -n "$body" ] || { [ "$pct" -ge 0 ] 2>/dev/null && body="$pct%"; }
if [ "$pct" -ge 0 ] 2>/dev/null; then
  exec notify-send -a carpatic-osd -u low -t 1500 -i "$icon" \
    -h "string:x-dunst-stack-tag:osd-$id" -h "int:value:$pct" "$title" "$body"
fi
exec notify-send -a carpatic-osd -u low -t 1500 -i "$icon" -h "string:x-dunst-stack-tag:osd-$id" "$title" "$body"
