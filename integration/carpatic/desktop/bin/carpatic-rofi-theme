#!/bin/sh
# carpatic-rofi-theme : print the rofi theme file for the active profile and light/dark mode.
# Configurator output (per profile, regenerated by carpatic-apply on every theme/accent change) wins; otherwise the design-system theme.
[ -r "$HOME/.config/carpatic/profile.env" ] && . "$HOME/.config/carpatic/profile.env"
[ -r "$HOME/.config/carpatic/appearance.env" ] && . "$HOME/.config/carpatic/appearance.env"
CUR=${CARPATIC_STATE:-$HOME/.local/state/carpatic}/current
r=$CUR/rofi/${LAUNCHER:-tiling}.rasi
if [ -f "$r" ]; then echo "$r"; exit 0; fi
mode=dark; { [ "${MODE:-}" = light ] || [ -f "$HOME/.config/carpatic/light" ]; } && mode=light
echo "/usr/local/share/carpatic/rofi/carpatic-$mode.rasi"
