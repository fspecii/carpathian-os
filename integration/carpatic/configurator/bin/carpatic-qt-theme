#!/bin/sh
# carpatic-qt-theme COLORS.toml OUTDIR : generate the Kvantum theme "Carpathian" from the palette (Qt5 and Qt6 apps with the kvantum style).
# Base = KvFlat (dark) / KvFlatLight; greys are re-mapped between the palette's background and foreground, blue accents become the accent.
# Apps pick it up with QT_STYLE_OVERRIDE=kvantum (set by ~/.config/carpatic/env.sh, /etc/profile.d and carpatic-launch/carpatic-term).
COLORS=$1; OUT=${2:-/tmp}; K=/usr/share/Kvantum
command -v carpatic-render >/dev/null 2>&1 || exit 1
mode=$(sed -n 's/^mode *= *"\(.*\)"/\1/p' "$COLORS" | head -1)
if [ "$mode" = light ]; then base=KvFlatLight; else base=KvFlat; fi
[ -d "$K/$base" ] || { echo "kvantum themes not installed" >&2; exit 1; }
tpl=$(mktemp); cat > "$tpl" <<'EOT'
bg {{ background }}
dk {{ dark_background }}
lt {{ lighter_background }}
fg {{ foreground }}
muted {{ muted }}
accent {{ accent }}
sel {{ selection_background }}
afg {{ accent_fg }}
link {{ blue }}
vis {{ magenta }}
EOT
carpatic-render "$COLORS" "$tpl" > "$OUT/kv.pal"; rm -f "$tpl"
# Kvantum notices a theme *name* change in kvantum.kvconfig and restyles running apps, so alternate between two names
KV=$HOME/.config/Kvantum; cur=$(sed -n 's/^theme=//p' "$KV/kvantum.kvconfig" 2>/dev/null)
case $cur in CarpaticA) NAME=CarpaticB;; *) NAME=CarpaticA;; esac
D=$KV/$NAME; mkdir -p "$D"
awk -v MODE="$mode" -f - "$OUT/kv.pal" "$K/$base/$base.svg" > "$D/$NAME.svg" <<'AWK'
function hx(s,  i,v,c,d){s=tolower(s);v=0;for(i=1;i<=length(s);i++){c=substr(s,i,1);d=index("0123456789abcdef",c)-1;v=v*16+d}return v}
function rgbof(h){sub(/^#/,"",h);R=hx(substr(h,1,2));G=hx(substr(h,3,2));B=hx(substr(h,5,2))}
function h2(n){n=int(n+0.5);if(n<0)n=0;if(n>255)n=255;return sprintf("%02x",n)}
function mixc(a,b,p,  r1,g1,b1){rgbof(a);r1=R;g1=G;b1=B;rgbof(b);return "#" h2(r1+(R-r1)*p) h2(g1+(G-g1)*p) h2(b1+(B-b1)*p)}
NR==FNR{P[$1]=$2;next}
{
  line=$0; out=""
  while (match(line,/#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]/)) {
    pre=substr(line,1,RSTART-1); col=substr(line,RSTART,7); line=substr(line,RSTART+7)
    rgbof(col); mx=(R>G?R:G); mx=(mx>B?mx:B); mn=(R<G?R:G); mn=(mn<B?mn:B)
    if (mx-mn<14) { L=R/255; if (MODE=="light") nc=mixc(P["fg"],P["bg"],L); else nc=mixc(P["bg"],P["fg"],L*1.1) }
    else if (B>R+25 && B>=G-10) nc=P["accent"]
    else nc=col
    out=out pre nc
  }
  print out line
}
AWK
# kvconfig: palette colours in [GeneralColors]; section colours inherit from the base file
awk -f - "$OUT/kv.pal" "$K/$base/$base.kvconfig" > "$D/$NAME.kvconfig" <<'AWK'
NR==FNR{P[$1]=$2;next}
/^\[GeneralColors\]/ {print; ingc=1; 
  print "window.color=" P["bg"]; print "base.color=" P["dk"]; print "alt.base.color=" P["lt"]; print "button.color=" P["lt"]; print "light.color=" P["lt"]; print "mid.light.color=" P["lt"]
  print "dark.color=" P["bg"]; print "mid.color=" P["lt"]; print "highlight.color=" P["accent"]; print "inactive.highlight.color=" P["sel"]
  print "text.color=" P["fg"]; print "window.text.color=" P["fg"]; print "button.text.color=" P["fg"]; print "disabled.text.color=" P["muted"]
  print "tooltip.base.color=" P["lt"]; print "tooltip.text.color=" P["fg"]; print "highlight.text.color=" P["afg"]; print "link.color=" P["link"]; print "link.visited.color=" P["vis"]; next}
/^\[/ {ingc=0}
ingc {next}
{print}
AWK
printf '[General]\ntheme=%s\n' "$NAME" > "$KV/kvantum.kvconfig"
rm -rf "$KV/Carpatic" "$KV/Carpatic$( [ "$NAME" = CarpaticA ] && echo B || echo A )"
# Kate: matching editor colour theme (Qt apps with their own editor colours)
if [ -f "$HOME/.config/katerc" ] || command -v kate >/dev/null 2>&1; then
  T="Breeze Dark"; [ "$mode" = light ] && T="Breeze Light"
  f=$HOME/.config/katerc; touch "$f"
  if grep -q '^\[KTextEditor Renderer\]' "$f"; then sed -i '/^\[KTextEditor Renderer\]/,/^\[/ s/^Color Theme=.*/Color Theme='"$T"'/' "$f"; grep -q '^Color Theme=' "$f" || sed -i '/^\[KTextEditor Renderer\]/a Color Theme='"$T" "$f"
  else printf '\n[KTextEditor Renderer]\nColor Theme=%s\n' "$T" >> "$f"; fi
fi
