#!/bin/sh
# carpatic-render COLORS.toml TEMPLATE [KEY=VALUE ...]  >  output
# Omarchy-style template renderer in POSIX sh + awk.
#   {{ name }}            -> #rrggbb          {{ name_strip }} -> rrggbb      {{ name_rgb }} -> r,g,b
#   {{ mix a b 30 }}      -> blend of a and b (30% of b), also mix_strip / mix_rgb
#   {{ @KEY }}            -> extra KEY=VALUE given on the command line
#   {{ px 12 }}           -> 12 multiplied by the display scale (extra UI_SCALE, percent), rounded; generated .css/.rasi also get every Npx scaled
# Derived names: accent_fg, bar_bg, bar_fg, border, hover, selection_foreground, selection_background, purple.
# ACCENT=#rrggbb in the environment overrides the theme accent.
# carpatic-render --multi COLORS.toml LIST VARS   : render many templates in ONE awk process (what carpatic-apply uses).
#   LIST lines: TEMPLATE|OUTPUT[|nonl]   (nonl = strip newlines, for the OSC string)     VARS lines: KEY=VALUE (extras)
MULTI=0; LISTF=""
if [ "${1:-}" = --multi ]; then MULTI=1; shift; [ $# -eq 3 ] || { echo "usage: carpatic-render --multi colors.toml list vars" >&2; exit 2; }; colors=$1; LISTF=$2; tpl=$2; VARSF=$3; extras=""
  extras=$(cat "$VARSF")
else
  [ $# -ge 2 ] || { echo "usage: carpatic-render colors.toml template [K=V...]" >&2; exit 2; }
  colors=$1; tpl=$2; shift 2
  extras=""
  for kv in "$@"; do extras="$extras$kv
"; done
fi
MULTI=$MULTI EXTRAS="$extras" ACC="${ACCENT:-}" awk -f /dev/stdin "$colors" "$tpl" <<'AWK'
function hex2n(h,   i,c,v,d){h=tolower(h);v=0;for(i=1;i<=length(h);i++){c=substr(h,i,1);d=index("0123456789abcdef",c)-1;v=v*16+d}return v}
function rgbof(h,  s){s=h;sub(/^#/,"",s);R=hex2n(substr(s,1,2));G=hex2n(substr(s,3,2));B=hex2n(substr(s,5,2))}
function hx(n){n=int(n+0.5);if(n<0)n=0;if(n>255)n=255;return sprintf("%02x",n)}
function mixc(a,b,p,  r1,g1,b1){rgbof(a);r1=R;g1=G;b1=B;rgbof(b);return "#" hx(r1+(R-r1)*p/100) hx(g1+(G-g1)*p/100) hx(b1+(B-b1)*p/100)}
function lum(h){rgbof(h);return (0.299*R+0.587*G+0.114*B)}
function val(n,  v){v=C[n];if(v=="")v="#ff00ff";return v}
function fmt(v,suf){if(suf=="_strip"){sub(/^#/,"",v);return v}if(suf=="_rgb"){rgbof(v);return R "," G "," B}return v}
BEGIN{n=split(ENVIRON["EXTRAS"],ex,"\n");for(i=1;i<=n;i++){p=index(ex[i],"=");if(p>1)X[substr(ex[i],1,p-1)]=substr(ex[i],p+1)}
  US=X["UI_SCALE"]+0; if(US<100||US>400)US=100}
function derive(){
    if(ENVIRON["ACC"]!="")C["accent"]=ENVIRON["ACC"]
    if(C["magenta"]=="")C["magenta"]=C["red"]
    C["purple"]=C["magenta"]
    if(C["orange"]=="")C["orange"]=C["yellow"]
    if(C["brown"]=="")C["brown"]=C["red"]
    if(C["bright_foreground"]=="")C["bright_foreground"]=C["foreground"]
    if(C["dark_background"]=="")C["dark_background"]=C["background"]
    if(C["lighter_background"]=="")C["lighter_background"]=mixc(C["background"],C["foreground"],20)
    if(C["muted"]=="")C["muted"]=mixc(C["background"],C["foreground"],40)
    if(C["selection"]=="")C["selection"]=C["lighter_background"]
    C["accent_fg"]=(lum(C["accent"])>140)?"#08241d":"#ffffff"
    C["bar_bg"]=C["dark_background"]; C["bar_fg"]=C["foreground"]
    C["theme_type"]=C["mode"]
    C["sel_tint"]=mixc(C["dark_background"],C["accent"],(C["mode"]=="light")?20:12)
    if(C["neutral_title"]!="")C["sel_tint"]=mixc(C["dark_background"],C["foreground"],(C["mode"]=="light")?10:14)
    C["title_fg"]=C["foreground"]
    if(C["selection_foreground"]!="") {
        C["sel_tint"]=C["selection"]
        C["title_fg"]=C["selection_foreground"]
    }
    if(X["BSTYLE"]=="classic98" || X["BSTYLE"]=="luna") {
        C["sel_tint"]=C["accent"]
        if(C["selection_foreground"]=="")C["title_fg"]=(lum(C["accent"])>140)?"#000000":"#ffffff"
    }
    # view_bg = the page/content surface (lightest in light mode, darkest in dark mode), chrome_bg = toolbars/sidebars (the other one);
    # palettes order background/dark_background differently, so the GTK style layers pick by luminance (gtktheme/)
    if((lum(C["background"])>=lum(C["dark_background"]))==(C["mode"]=="light")){C["view_bg"]=C["background"];C["chrome_bg"]=C["dark_background"]}
    else{C["view_bg"]=C["dark_background"];C["chrome_bg"]=C["background"]}
    C["border"]=C["lighter_background"]
    C["hover"]=mixc(C["dark_background"],C["accent"],25)
    if(C["selection_foreground"]=="")C["selection_foreground"]=C["foreground"]; C["selection_background"]=C["selection"]
    C["mode"]=C["mode"]
  
}
function rl(line,  out,s,tok,pre,m,t,rep,suf,nm){ out=""; s=line
  while(match(s,/\{\{[^}]*\}\}/)){
    tok=substr(s,RSTART+2,RLENGTH-4); gsub(/^[ \t]+|[ \t]+$/,"",tok)
    pre=substr(s,1,RSTART-1); s=substr(s,RSTART+RLENGTH)
    m=split(tok,t," ");rep=""
    if(substr(t[1],1,1)=="@"){rep=X[substr(t[1],2)]}
    else if(t[1]=="px"){rep=int(t[2]*US/100+0.5); if(t[2]>=1&&rep<1)rep=1}
    else if(t[1] ~ /^mix(_strip|_rgb)?$/){suf=substr(t[1],4);rep=fmt(mixc(val(t[2]),val(t[3]),t[4]+0),suf)}
    else{nm=t[1];suf="";if(match(nm,/_(strip|rgb)$/)){suf=substr(nm,RSTART);nm=substr(nm,1,RSTART-1)}
         if(nm=="mode")rep=C["mode"]; else rep=fmt(val(nm),suf)}
    out=out pre rep
  }
  return out s
}
# CARPATIC: display scale. Generated CSS / rasi are written in logical px; every Npx is multiplied by UI_SCALE (percent) so GTK3 (whose CSS ignores the
# font DPI) and rofi get the same proportions at any scale. Hairlines stay at least 1 px, decorative huge radii (999px pills) stay as they are.
function pxs(r,  out,num,v){
  if(US==100) return r
  out=""
  while(match(r,/[0-9]+(\.[0-9]+)?px/)){
    num=substr(r,RSTART,RLENGTH-2)+0
    if(num>=1 && num<200){ v=int(num*US/100+0.5); if(v<1)v=1 } else v=num
    out=out substr(r,1,RSTART-1) v "px"; r=substr(r,RSTART+RLENGTH)
  }
  return out r
}
# tint2rc has no units: scale the numbers of the size / padding / border keys (a number followed by % is a share of the screen and stays)
function t2(r,  k,rest,out,n,i,t,a){
  if(US==100) return r
  if(!match(r,/^(rounded|border_width|panel_size|panel_margin|panel_padding|panel_spacing|launcher_padding|launcher_icon_size|launcher_spacing|taskbar_padding|taskbar_spacing|task_maximum_size|task_padding|task_spacing|systray_padding|systray_spacing|systray_icon_size|clock_padding|tooltip_padding|separator_padding|button_padding|battery_padding|execp_padding) *= */)) return r
  k=substr(r,1,RLENGTH); rest=substr(r,RLENGTH+1); n=split(rest,a," "); out=""
  for(i=1;i<=n;i++){ t=a[i]; if(t ~ /^[0-9]+$/ && !(i<n && a[i+1] ~ /^%/)){ t=int(t*US/100+0.5); if(a[i]+0>=1&&t<1)t=1 } out=out (i>1?" ":"") t }
  return k out
}
FNR==1{fileno++}
fileno==1{ # colors.toml
  line=$0; sub(/#[^"]*$/,"",line)
  if(match(line,/^[ \t]*[A-Za-z0-9_]+[ \t]*=[ \t]*"[^"]*"/)){
    k=line;sub(/^[ \t]*/,"",k);sub(/[ \t]*=.*/,"",k)
    v=line;sub(/^[^"]*"/,"",v);sub(/".*/,"",v)
    if(substr(v,1,1)!="#"&&v ~ /^[0-9a-fA-F]{6}$/)v="#" v
    C[k]=v
  }
  next
}
fileno==2{
  if(!ready){ ready=1; derive() }
  if(ENVIRON["MULTI"]!="1"){ print rl($0); next }
  # multi: this "template" is the list file
  split($0,L,"|"); tplf=L[1]; outf=L[2]; nonl=(L[3]=="nonl"); buf=""
  px=(outf ~ /\.(css|rasi)$/); tt=(outf ~ /\.tint2rc$/)
  while((getline tl < tplf)>0){ r=rl(tl); if(px) r=pxs(r); if(tt) r=t2(r); buf = buf (nonl ? r : r "\n") }
  close(tplf)
  if(nonl) printf "%s", buf > outf; else printf "%s", buf > outf
  close(outf)
}
AWK
