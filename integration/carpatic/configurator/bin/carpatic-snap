#!/bin/sh
# Native WM owns atomic keyboard snap geometry, restore state and focus.
act=${1:-}
case $act in left|right|max|restore) ;; *) echo 'Usage: carpatic-snap left|right|max|restore' >&2; exit 2;; esac
w=$(xdotool getactivewindow 2>/dev/null) || exit 1
if xprop -root _NET_SUPPORTED 2>/dev/null | grep -q _CARPATIC_SNAP; then
    exec python3 - "$w" "$act" <<'PYCODE'
import ctypes as c
import sys
class Data(c.Union):
    _fields_ = [('l', c.c_long*5), ('b', c.c_char*20)]
class Message(c.Structure):
    _fields_ = [('type', c.c_int), ('serial', c.c_ulong), ('send_event', c.c_int), ('display', c.c_void_p), ('window', c.c_ulong), ('message_type', c.c_ulong), ('format', c.c_int), ('data', Data)]
class Event(c.Union):
    _fields_ = [('message', Message), ('pad', c.c_long*24)]
x=c.CDLL('libX11.so.6')
x.XOpenDisplay.argtypes=[c.c_char_p];x.XOpenDisplay.restype=c.c_void_p
x.XDefaultRootWindow.argtypes=[c.c_void_p];x.XDefaultRootWindow.restype=c.c_ulong
x.XInternAtom.argtypes=[c.c_void_p,c.c_char_p,c.c_int];x.XInternAtom.restype=c.c_ulong
x.XSendEvent.argtypes=[c.c_void_p,c.c_ulong,c.c_int,c.c_long,c.POINTER(Event)];x.XSendEvent.restype=c.c_int
x.XFlush.argtypes=[c.c_void_p];x.XCloseDisplay.argtypes=[c.c_void_p]
d=x.XOpenDisplay(None)
if not d:raise SystemExit('Cannot open X11 display')
try:
    e=Event();e.message.type=33;e.message.send_event=1;e.message.display=d
    e.message.window=int(sys.argv[1]);e.message.message_type=x.XInternAtom(d,b'_CARPATIC_SNAP',0);e.message.format=32
    e.message.data.l[0]={'left':0,'right':1,'max':2,'restore':3}[sys.argv[2]]
    if not x.XSendEvent(d,x.XDefaultRootWindow(d),0,(1<<20)|(1<<19),c.byref(e)):raise SystemExit('Snap request was not sent')
    x.XFlush(d)
finally:x.XCloseDisplay(d)
PYCODE
fi
# Compatibility path for another WM: published extents/workarea replace guesses.
[ ! -r "$HOME/.config/carpatic/profile.env" ] || . "$HOME/.config/carpatic/profile.env"
set -- "$1" $(xdotool getdisplaygeometry)
act=$1; SW=$2; SH=$3
BW=$(xwininfo -id "$w" 2>/dev/null | awk '/Border width:/{print $NF}'); BW=${BW:-0}
L=$BW; R=$BW; T=$BW; B=$BW
extents=$(xprop -id "$w" _NET_FRAME_EXTENTS 2>/dev/null | sed -n 's/.*= //p' | tr ' ,' '  ')
if [ -n "$extents" ]; then set -- $extents; [ "$#" -ne 4 ] || { L=$1; R=$2; T=$3; B=$4; }; fi
X0=${BAR_LEFT:-0}; Y0=${BAR_TOP:-0}; AW=$((SW - X0)); AH=$((SH - Y0 - ${BAR_BOTTOM:-0}))
# the live work area published by dwm (bars and docks of the running panel, any design, size or scale) wins over the profile's nominal sizes
wa=$(xprop -root _NET_WORKAREA 2>/dev/null | sed -n 's/.*= *\([0-9]*\), *\([0-9]*\), *\([0-9]*\), *\([0-9]*\).*/\1 \2 \3 \4/p')
[ -n "$wa" ] && { set -- "$act" $wa; X0=$2; Y0=$3; AW=$4; AH=$5; }
# In an auto-tiling workspace the arrows move between tiles (like LinPad and tiling window managers); Up/Down maximise and restore. Snapping is for floating workspaces.
if [ "$(xprop -root _CARPATIC_LAYOUT 2>/dev/null | sed -n 's/.*= *"\(.*\)"/\1/p')" = tile ]; then
  case $act in
    left)  exec xdotool key --clearmodifiers super+alt+k ;;
    right) exec xdotool key --clearmodifiers super+alt+j ;;
    max)   exec xdotool key --clearmodifiers super+z ;;
    restore) eval "$(xdotool getwindowgeometry --shell "$w")"; [ "$WIDTH" -ge $((AW - 40)) ] && exec xdotool key --clearmodifiers super+z; exit 0 ;;
  esac
fi
S=${XDG_RUNTIME_DIR:-/tmp}/carpatic-snap.$w
case $act in
  restore) [ -f "$S" ] && { read -r x y ww hh < "$S"; xdotool windowsize "$w" "$ww" "$hh" windowmove "$w" "$x" "$y"; rm -f "$S"; }; exit 0 ;;
esac
if [ ! -f "$S" ]; then
  eval "$(xdotool getwindowgeometry --shell "$w")"; echo "$X $Y $WIDTH $HEIGHT" > "$S"
fi
case $act in
  left)  x=$X0;              ww=$((AW/2 - L - R)); ;;
  right) x=$((X0 + AW/2));   ww=$((AW - AW/2 - L - R)); ;;
  max)   x=$X0;              ww=$((AW - L - R)); ;;
esac
xdotool windowsize "$w" "$ww" "$((AH - T - B))" windowmove "$w" "$x" "$Y0"
xdotool windowactivate --sync "$w"
