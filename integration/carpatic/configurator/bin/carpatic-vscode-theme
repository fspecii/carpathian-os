#!/usr/bin/env python3
"""carpatic-vscode-theme THEME.json [dark|light]
Installs the generated "Carpatic" colour theme for every VS Code family editor it finds and selects it, with live updates:
 - extension "carpatic.carpatic-theme" in the extensions dir of each editor (applies after a window reload / restart)
 - the same colours as workbench.colorCustomizations["[Carpatic]"] in settings.json, which editors watch, so a running window retints at once
Editors/paths (config dir -> extensions dir):
  VSCodium, Code - OSS (native build / compat box):  ~/.config/VSCodium|Code - OSS/User -> ~/.vscode-oss/extensions
  VS Code (Ubuntu compat box shares $HOME):          ~/.config/Code/User -> ~/.vscode/extensions
  Flatpak VSCodium / Code - OSS / VS Code:           ~/.var/app/<id>/config/<name>/User -> ~/.var/app/<id>/data/<codium|vscode-oss|vscode>/extensions
A settings.json that has comments (JSONC) is left alone and reported: then pick the theme "Carpatic" once by hand."""
import json, os, re, sys, shutil
H = os.path.expanduser("~")
src, mode = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "dark")
theme = json.load(open(src))
theme["name"] = "Carpatic"
EDITORS = [  # (user dir, extensions dir)
    (f"{H}/.config/VSCodium/User", f"{H}/.vscode-oss/extensions"),
    (f"{H}/.config/Code - OSS/User", f"{H}/.vscode-oss/extensions"),
    (f"{H}/.config/Code/User", f"{H}/.vscode/extensions"),
    (f"{H}/.var/app/com.vscodium.codium/config/VSCodium/User", f"{H}/.var/app/com.vscodium.codium/data/codium/extensions"),
    (f"{H}/.var/app/com.visualstudio.code-oss/config/Code - OSS/User", f"{H}/.var/app/com.visualstudio.code-oss/data/vscode-oss/extensions"),
    (f"{H}/.var/app/com.visualstudio.code/config/Code/User", f"{H}/.var/app/com.visualstudio.code/data/vscode/extensions"),
]
VERSION = "1.0.0"
pkg = {"name": "carpatic-theme", "displayName": "Carpatic", "publisher": "carpatic", "version": VERSION, "engines": {"vscode": "^1.60.0"},
       "categories": ["Themes"], "contributes": {"themes": [{"label": "Carpatic", "uiTheme": "vs" if mode == "light" else "vs-dark", "path": "./themes/carpatic.json"}]}}
done = []
for user, ext in EDITORS:
    if not (os.path.isdir(user) or os.path.isdir(ext)):
        continue
    d = os.path.join(ext, f"carpatic.carpatic-theme-{VERSION}")
    os.makedirs(os.path.join(d, "themes"), exist_ok=True)
    json.dump(pkg, open(os.path.join(d, "package.json"), "w"), indent=1)
    json.dump(theme, open(os.path.join(d, "themes", "carpatic.json"), "w"), indent=1)
    # register for editors that keep extensions.json
    ej = os.path.join(ext, "extensions.json")
    try:
        lst = json.load(open(ej)) if os.path.exists(ej) else []
        lst = [e for e in lst if e.get("identifier", {}).get("id") != "carpatic.carpatic-theme"]
        lst.append({"identifier": {"id": "carpatic.carpatic-theme"}, "version": VERSION, "location": {"$mid": 1, "path": d, "scheme": "file"}, "relativeLocation": os.path.basename(d)})
        json.dump(lst, open(ej, "w"))
    except Exception:
        pass
    sj = os.path.join(user, "settings.json")
    if os.path.isdir(user):
        try:
            txt = open(sj).read() if os.path.exists(sj) else "{}"
            if re.search(r"(^|[^:\"])//|/\*", txt):
                print(f"{sj}: has comments, not edited; choose the theme Carpatic once", file=sys.stderr)
            else:
                s = json.loads(txt or "{}")
                s["workbench.colorTheme"] = "Carpatic"
                s.setdefault("workbench.colorCustomizations", {})["[Carpatic]"] = theme.get("colors", {})
                s.setdefault("editor.semanticTokenColorCustomizations", {})["[Carpatic]"] = {"enabled": True, "rules": theme.get("semanticTokenColors", {})}
                s.setdefault("editor.tokenColorCustomizations", {})["[Carpatic]"] = {"textMateRules": theme.get("tokenColors", [])}
                tmp = sj + ".tmp"; json.dump(s, open(tmp, "w"), indent=2); os.replace(tmp, sj)
        except Exception as e:
            print(f"{sj}: {e}", file=sys.stderr)
    done.append(user)
print("\n".join(done))
