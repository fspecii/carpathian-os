+/* CARPATIC: secondary docks (tint2 panel_window_name = "carpatic-dock*"): not a bar, they only reserve space via _NET_WM_STRUT_PARTIAL */
+int
+isdock2(Window win)
+{
+	char *name = NULL;
+	int r = 0;
+	if (getwinatomprop(win, netatom[NetWMWindowType]) != netatom[NetWMWindowTypeDock])
+		return 0;
+	if (XFetchName(dpy, win, &name) && name) {
+		r = strncmp(name, "carpatic-dock", 13) == 0;
+		XFree(name);
+	}
+	return r;
+}
+
+void
+managedock2(Window win, XWindowAttributes *wa)
+{
+	Monitor *m = recttomon(wa->x, wa->y, wa->width, wa->height);
+	Atom a = XInternAtom(dpy, "_NET_WM_STRUT_PARTIAL", False), t;
+	unsigned char *d = NULL;
+	unsigned long n, after;
+	int f, i;
+	long *v;
+	if (!m) return;
+	for (i = 0; i < NDOCK2 && docks2[i].w && docks2[i].w != win; i++);
+	if (i == NDOCK2) return;
+	docks2[i].w = win; docks2[i].m = m;
+	docks2[i].l = docks2[i].r = docks2[i].t = docks2[i].b = 0;
+	if (XGetWindowProperty(dpy, win, a, 0, 12, False, XA_CARDINAL, &t, &f, &n, &after, &d) == Success && d && n >= 4) {
+		v = (long *)d;
+		docks2[i].l = v[0]; docks2[i].r = v[1]; docks2[i].t = v[2]; docks2[i].b = v[3];
+	}
+	if (d) XFree(d);
+	XSelectInput(dpy, win, StructureNotifyMask);
+	XMapWindow(dpy, win);
+	XRaiseWindow(dpy, win);
+	updatebarpos(m);
+	arrange(m);
+}
+
+int
+removedock2(Window win)
+{
+	int i;
+	for (i = 0; i < NDOCK2; i++)
+		if (docks2[i].w == win) {
+			Monitor *m = docks2[i].m;
+			docks2[i].w = 0;
+			if (m) {
+				updatebarpos(m);
+				if (m->barwin && !m->isalt)
+					XMoveResizeWindow(dpy, m->barwin, m->wx, m->by, m->ww, bh);
+				arrange(m);
+			}
+			return 1;
+		}
+	return 0;
+}
