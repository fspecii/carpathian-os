{ mod="",      key="Print", desc="Screenshot (region)", func="spawn", exec=["carpatic-screenshot"] },
{ mod="SHIFT", key="Print", desc="Screenshot (full)",   func="spawn", exec=["carpatic-screenshot", "full"] },
{ mod="SUPER", key="F1",    desc="Show keybindings",    func="spawn", exec=["carpatic-keys"] },
{ mod="SUPER", key="F2",    desc="Settings",   func="spawn", exec=["carpatic-settings"] },
{ mod="SUPER CTRL ALT", key="f",   desc="Layout: floating (all tags, used by carpatic-layout)", func="setlayout", layout_idx=1 },
{ mod="SUPER CTRL ALT", key="t",  desc="Layout: tiling (all tags, used by carpatic-layout)",   func="setlayout", layout_idx=0 },
{ mod="SUPER ALT",      key="space", desc="Carpathian menu",          func="spawn", exec=["carpatic-menu"] },
{ mod="SUPER ALT",      key="w",     desc="Peek at widgets",     func="spawn", exec=["carpatic-widgets", "peek"] },
{ mod="SUPER CTRL",     key="space", desc="Next wallpaper",         func="spawn", exec=["carpatic", "theme", "wallpaper", "next"] },
{ mod="SUPER CTRL SHIFT", key="space", desc="Browse themes (arrows), Esc undoes", func="spawn", exec=["carpatic-theme-picker"] },
{ mod="SUPER ALT",      key="t",      desc="Auto-tiling on or off (this workspace)", func="togglelayout" },
{ mod="SUPER ALT",      key="f",      desc="Float or tile this window",  func="togglefloating" },
{ mod="SUPER ALT",      key="j",      desc="Tiling: focus next window",  func="focusstack", i=1 },
{ mod="SUPER ALT",      key="k",      desc="Tiling: focus previous window", func="focusstack", i=-1 },
{ mod="SUPER ALT SHIFT", key="j",     desc="Tiling: move window down the stack", func="movestack", i=1 },
{ mod="SUPER ALT SHIFT", key="k",     desc="Tiling: move window up the stack",   func="movestack", i=-1 },
{ mod="SUPER ALT",      key="Return", desc="Tiling: swap window with the master", func="zoom" },
{ mod="SUPER ALT",      key="h",      desc="Tiling: make the master area smaller", func="setmfact", f=-0.05 },
{ mod="SUPER ALT",      key="l",      desc="Tiling: make the master area larger",  func="setmfact", f=0.05 },
{ mod="SUPER ALT",      key="i",      desc="Tiling: one more window in the master area", func="incnmaster", i=1 },
{ mod="SUPER ALT",      key="u",      desc="Tiling: one fewer window in the master area", func="incnmaster", i=-1 },
{ mod="CTRL ALT",       key="Left",   desc="Previous workspace",         func="viewrel", i=-1 },
{ mod="CTRL ALT",       key="Right",  desc="Next workspace",             func="viewrel", i=1 },
{ mod="CTRL ALT SHIFT", key="Left",   desc="Send window to previous workspace", func="tagrel", i=-1 },
{ mod="CTRL ALT SHIFT", key="Right",  desc="Send window to next workspace",     func="tagrel", i=1 },
{ mod="SUPER CTRL",     key="Left",   desc="Previous workspace",         func="viewrel", i=-1 },
{ mod="SUPER CTRL",     key="Right",  desc="Next workspace",             func="viewrel", i=1 },
{ mod="SUPER CTRL SHIFT", key="Left", desc="Send window to previous workspace", func="tagrel", i=-1 },
{ mod="SUPER CTRL SHIFT", key="Right", desc="Send window to next workspace",    func="tagrel", i=1 },
{ mod="SUPER",          key="k",      desc="Show every keyboard shortcut", func="spawn", exec=["carpatic-cheatsheet", "show"] },
{ mod="CTRL ALT",       key="Up",     desc="Workspace overview (drag windows between workspaces)", func="spawn", exec=["carpatic-overview"] },
