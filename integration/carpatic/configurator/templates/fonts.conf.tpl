<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Generated by carpatic-apply. Change via Carpatic Settings > Fonts. -->
<fontconfig>
  <match target="font">
    <edit name="antialias" mode="assign"><bool>{{ @AA_BOOL }}</bool></edit>
    <edit name="hinting" mode="assign"><bool>{{ @HINTING_BOOL }}</bool></edit>
    <edit name="hintstyle" mode="assign"><const>hint{{ @HINTING }}</const></edit>
    <edit name="rgba" mode="assign"><const>{{ @RGBA }}</const></edit>
    <edit name="lcdfilter" mode="assign"><const>{{ @LCDFILTER }}</const></edit>
    <edit name="autohint" mode="assign"><bool>false</bool></edit>
  </match>
  <alias binding="same"><family>sans-serif</family><prefer><family>{{ @UI }}</family><family>Noto Sans</family><family>DejaVu Sans</family></prefer></alias>
  <alias binding="same"><family>system-ui</family><prefer><family>{{ @UI }}</family></prefer></alias>
  <alias binding="same"><family>monospace</family><prefer><family>{{ @MONO }}</family><family>DejaVu Sans Mono</family><family>Symbols Nerd Font Mono</family></prefer></alias>
  <alias binding="same"><family>serif</family><prefer><family>Noto Serif</family><family>DejaVu Serif</family></prefer></alias>
  <alias binding="same"><family>emoji</family><prefer><family>Noto Color Emoji</family></prefer></alias>
</fontconfig>
