popover modelbutton:hover, modelbutton:hover { background-color: alpha(@cp_accent, 0.18); color: @cp_fg; }
popover separator { background-color: @cp_line; margin: 4px 6px; }
tooltip, tooltip.background { border-radius: 6px; background-color: @cp_tip_bg; color: @cp_tip_fg; border: none; box-shadow: 0 4px 14px @cp_shadow_m; padding: 0; }
tooltip label { padding: 4px 9px; font-size: 92%; }

/* ---- frames, separators, info bars, dialogs ---- */
frame > border { border: 1px solid @cp_line; border-radius: 8px; }
separator { background-color: @cp_line; min-width: 1px; min-height: 1px; }
paned > separator { background-color: @cp_line; background-image: none; min-width: 1px; min-height: 1px; }
infobar { border: none; border-radius: 0; }
infobar.info, infobar.question { background-color: alpha(@cp_accent, 0.18); color: @cp_fg; }
infobar.warning { background-color: alpha(@cp_yellow, 0.25); color: @cp_fg; }
infobar.error { background-color: alpha(@cp_red, 0.22); color: @cp_fg; }
messagedialog .dialog-action-area, dialog .dialog-action-area { padding: 8px 16px 16px; }
messagedialog .dialog-action-area > button, dialog .dialog-action-area > button { min-width: 84px; margin: 0 4px; border-radius: 7px; }
messagedialog .dialog-action-area, messagedialog box.dialog-action-area { border: none; }
messagedialog, dialog { background-color: @cp_chrome; }
.dim-label, label.dim-label { color: @cp_text2; opacity: 1; }
.heading, label.heading { font-weight: 600; color: @cp_fg; }
calendar { border-radius: 8px; padding: 2px; }
calendar:selected { background-color: @cp_accent; color: @cp_accent_fg; border-radius: 999px; }
expander arrow { color: @cp_text2; }
:link, button.link label { color: @cp_accent; }
*:focus-visible { outline: 2px solid alpha(@cp_accent, 0.7); outline-offset: 1px; -gtk-outline-radius: 8px; }
entry:focus-visible, button:focus-visible { outline: none; }
button:focus-visible { box-shadow: 0 0 0 3px alpha(@cp_accent, 0.38); }

/* ---- Thunar (GTK3 file manager): window, classes .thunar .shortcuts-pane .sidebar .path-bar .path-bar-button .standard-view ---- */
.thunar toolbar { padding: 6px 10px; }
.thunar toolbar toolbutton > button { min-height: 26px; min-width: 28px; }
.thunar .path-bar { background-color: alpha(@cp_fg, 0.06); border-radius: 6px; padding: 2px; margin: 0 6px; }
.thunar .path-bar > button, .thunar button.path-bar-button, .thunar button.location-button {
  min-height: 22px; padding: 1px 12px; margin: 0; border: none; border-radius: 6px; background-image: none; background-color: transparent; box-shadow: none; color: @cp_text2; font-weight: 500; }
.thunar .path-bar > button:hover, .thunar button.path-bar-button:hover { background-color: @cp_hover; color: @cp_fg; }
.thunar .path-bar > button:checked, .thunar button.path-bar-button:checked { background-color: alpha(@cp_accent, 0.2); color: @cp_fg; }
.thunar .path-bar > button + button { margin-left: 2px; }
.thunar .sidebar, .thunar .shortcuts-pane, .thunar treeview.sidebar { background-color: @cp_sidebar; }
.thunar .shortcuts-pane { padding: 6px 4px; }
.thunar .shortcuts-pane:selected, .thunar .shortcuts-pane:selected:focus { background-color: alpha(@cp_accent, 0.22); color: @cp_fg; border-radius: 6px;  }
.thunar .shortcuts-pane:hover:not(:selected) { background-color: @cp_hover; border-radius: 7px; }
.thunar .standard-view { background-color: @cp_view; }
.thunar iconview:selected, .thunar iconview:selected:focus { background-color: alpha(@cp_accent, 0.22); color: @cp_fg; border-radius: 8px; }
.thunar .disk-space-usage-bar { min-height: 3px; border-radius: 999px; }
.thunar paned > separator { min-width: 1px; background-color: @cp_line; }
/* Thunar 4.20: .sidebar is the side pane box; the tree view inside is a plain treeview.view */
.thunar .sidebar treeview.view, .thunar .shortcuts-pane treeview.view, .thunar treeview.view.shortcuts-pane { background-color: transparent; }
.thunar .sidebar treeview.view:selected, .thunar .sidebar treeview.view:selected:focus, .thunar treeview.view.shortcuts-pane:selected, .thunar treeview.view.shortcuts-pane:selected:focus { background-color: alpha(@cp_accent, 0.22); color: @cp_fg; border-radius: 6px;  }
.thunar .sidebar treeview.view:hover:not(:selected) { background-color: @cp_hover; border-radius: 6px; }
.thunar .sidebar scrolledwindow, .thunar .sidebar { background-color: @cp_sidebar; }
.thunar button.slider-button { padding: 0 3px; min-width: 14px; min-height: 22px; }
.thunar .sidebar treeview.view, .thunar treeview.view.shortcuts-pane { padding: 7px 4px; }

.carpatic-fake-titlebar { background-color: @cp_chrome; border-bottom: 1px solid transparent; }
/* UKUI-like: 38 px title bar, accent-tinted hover, 6 px radii */
headerbar button.titlebutton { min-height: 30px; min-width: 30px; border-radius: 6px; }
headerbar button.titlebutton.close:hover { background-color: #e7202b; color: #fff; }
/* Thunar in a headerbar (misc-use-csd): the toolbar lives inside the title bar */
.thunar headerbar toolbar, headerbar toolbar { background: none; background-color: transparent; border: none; padding: 0; box-shadow: none; }
.thunar headerbar { padding: 0 8px; }
.thunar headerbar .path-bar { margin: 0 8px; }
/* UKUI: menu bar visible, flat path bar with accent underline, light accent selection */
.thunar menubar { background-color: @cp_chrome; border-bottom: 1px solid @cp_line; }
.thunar .path-bar { background: none; padding: 0; }
.thunar .path-bar > button { border-radius: 0; padding: 1px 12px; }
.thunar .path-bar > button:checked { background: none; color: @cp_accent; box-shadow: inset 0 -2px 0 @cp_accent; }
.thunar toolbar { background-color: @cp_view; border-bottom: 1px solid @cp_line; }

/* ---- shared app classes (cp-*): Settings, Welcome, App Store, panel flyouts use these so the whole OS follows the style ---- */
.cp-title { font-size: 150%; font-weight: 600; }
.cp-h1 { font-size: 200%; font-weight: 600; }
.cp-caption, .cp-sub { color: @cp_text2; font-size: 90%; }
.cp-card { background-color: @cp_view; border: 1px solid @cp_line; border-radius: 8px; padding: 14px; background-image: none; box-shadow: none; }
.cp-card:hover { background-color: mix(@cp_view, @cp_fg, 0.04); }
.cp-card:checked, .cp-card.selected { border: 2px solid @cp_accent; padding: 13px; background-color: alpha(@cp_accent, 0.12); }
.cp-pill, button.cp-pill { border-radius: 999px; padding: 4px 16px; }
.cp-pill:checked, button.cp-pill:checked { background-color: @cp_accent; color: @cp_accent_fg; background-image: none; }
.cp-badge { background-color: @cp_accent; color: @cp_accent_fg; border-radius: 999px; padding: 1px 10px; font-size: 85%; font-weight: 600; }
.cp-sidebar { background-color: @cp_sidebar; border-right: 1px solid @cp_line; }
.cp-sidebar-row { padding: 6px 12px; margin: 1px 8px; border-radius: 6px; }
.cp-sidebar-row:selected, .cp-sidebar-row.selected { background-color: alpha(@cp_accent, 0.22); color: @cp_fg;  }
.cp-section { color: @cp_text2; font-size: 85%; font-weight: 600; margin: 12px 20px 2px 20px; }
.cp-flyout { background-color: @cp_menu_bg; color: @cp_fg; border: 1px solid @cp_line_strong; border-radius: 8px; box-shadow: 0 10px 30px @cp_shadow_l; padding: 8px; }
.cp-flyout-row { padding: 6px 10px; border-radius: 6px; }
.cp-flyout-row:hover { background-color: @cp_hover; }
.cp-tile { background-color: @cp_field; border-radius: 8px; padding: 10px 12px; border: 1px solid transparent; background-image: none; box-shadow: none; }
.cp-tile:hover { background-color: @cp_hover; }
.cp-tile:checked, .cp-tile.on { background-color: @cp_accent; color: @cp_accent_fg; }
.cp-search, entry.cp-search { border-radius: 6px; }
.cp-primary, button.cp-primary { background-color: @cp_accent; color: @cp_accent_fg; background-image: none; border-color: transparent; font-weight: 600; border-radius: 6px; }
.cp-primary:hover { background-color: lighter(@cp_accent); }
