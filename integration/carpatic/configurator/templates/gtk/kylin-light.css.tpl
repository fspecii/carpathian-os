spinbutton button:hover { background-color: @cp_hover; }

/* combo / menu buttons */
combobox button.combo, combobox box button { padding-right: 8px; }
button.combo arrow, menubutton arrow, arrow { color: @cp_text2; }

/* ---- toggles ---- */
check, radio { min-width: 16px; min-height: 16px; margin: 2px 4px 2px 0; border: 1px solid @cp_line_strong; background-image: none; background-color: @cp_view; color: transparent;
  box-shadow: inset 0 1px 1px @cp_shadow_s; -gtk-icon-shadow: none; }
