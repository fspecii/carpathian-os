switch { min-height: 20px; min-width: 40px; border-radius: 999px; border: 1px solid @cp_line_strong; background-image: none; background-color: @cp_track; color: transparent;
  box-shadow: inset 0 1px 2px @cp_shadow_s; font-size: 0; transition: background-color 160ms ease-out; }
