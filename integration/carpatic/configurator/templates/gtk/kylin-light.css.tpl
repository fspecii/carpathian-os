  background-image: linear-gradient(to bottom, lighter(@cp_accent), @cp_accent); background-color: @cp_accent; border-color: alpha(black, 0.2); color: @cp_accent_fg;
  box-shadow: 0 1px 1px @cp_shadow_s; }
