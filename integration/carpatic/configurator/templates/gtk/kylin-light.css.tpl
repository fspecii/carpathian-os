/* ---- sliders & progress ---- */
scale trough { min-height: 4px; min-width: 4px; border-radius: 999px; background-color: @cp_track; border: none; box-shadow: none; }
scale highlight, scale fill { border-radius: 999px; background-color: @cp_accent; border: none; background-image: none; }
scale slider { min-width: 16px; min-height: 16px; margin: -7px; border-radius: 999px; border: 0.5px solid alpha(black, 0.2); background-image: none; background-color: @cp_knob;
  box-shadow: 0 1px 3px @cp_shadow_m; }
scale slider:hover { box-shadow: 0 1px 4px @cp_shadow_l; }
