/* Carpathian widget polish for GTK3 and GTK4. Import AFTER colors-<mode>.css.
   Radii/spacing come from tokens: sm=6 md=10 lg=14. Generated, do not edit. */
window, .background { font-family: "Inter", "Noto Sans", sans-serif; font-size: 14px; }
.monospace, textview.monospace, .terminal { font-family: "JetBrains Mono", monospace; }
button { border-radius: 6px; padding: 6px 14px; min-height: 20px; border: 1px solid @borders; background-image: none;
  background-color: @card_bg_color; color: @window_fg_color; box-shadow: none; transition: background-color 120ms cubic-bezier(0.2, 0, 0, 1); }
button:hover { background-color: alpha(@window_fg_color, 0.07); }
button:active, button:checked { background-color: alpha(@window_fg_color, 0.12); }
button.suggested-action { background-color: @accent_bg_color; color: @accent_fg_color; border-color: transparent; font-weight: 600; }
button.suggested-action:hover { background-color: shade(@accent_bg_color, 1.08); }
button.destructive-action { background-color: @destructive_bg_color; color: @destructive_fg_color; border-color: transparent; }
entry, spinbutton, textview { border-radius: 6px; border: 1px solid @borders; background-color: @view_bg_color; color: @view_fg_color; padding: 6px 10px; box-shadow: none; }
entry:focus, spinbutton:focus-within { border-color: @accent_bg_color; box-shadow: 0 0 0 2px alpha(@accent_bg_color, 0.35); }
headerbar, .titlebar { background-color: @headerbar_bg_color; color: @headerbar_fg_color; border-bottom: 1px solid @headerbar_border_color; box-shadow: none; min-height: 40px; }
.card, frame > border, list.boxed-list { border-radius: 10px; border: 1px solid @borders; background-color: @card_bg_color; box-shadow: none; }
popover > contents, menu, .menu { border-radius: 10px; border: 1px solid @borders; background-color: @popover_bg_color; }
menuitem, row, modelbutton { border-radius: 6px; }
row:selected, menuitem:hover, modelbutton:hover, treeview:selected { background-color: alpha(@accent_bg_color, 0.22); color: @window_fg_color; }
list.navigation-sidebar row:selected, .sidebar row:selected { background-color: alpha(@accent_bg_color, 0.22); }
switch { border-radius: 999px; background-color: alpha(@window_fg_color, 0.18); border: none; }
switch:checked { background-color: @accent_bg_color; }
switch slider { border-radius: 999px; background-color: #ffffff; }
scale trough, progressbar trough { border-radius: 999px; background-color: alpha(@window_fg_color, 0.14); min-height: 6px; }
scale highlight, progressbar progress { border-radius: 999px; background-color: @accent_bg_color; }
scrollbar slider { border-radius: 999px; min-width: 6px; min-height: 6px; background-color: alpha(@window_fg_color, 0.30); }
tooltip { border-radius: 6px; background-color: @popover_bg_color; color: @window_fg_color; border: 1px solid @borders; }
*:focus-visible { outline: 2px solid @accent_bg_color; outline-offset: 1px; }
/* ---- Carpathian style layer: palette roles (gtktheme/). Everything below is derived from these. ---- */
@define-color cp_bg {{ background }};
@define-color cp_fg {{ foreground }};
@define-color cp_view {{ view_bg }};
@define-color cp_chrome {{ chrome_bg }};
@define-color cp_accent {{ accent }};
@define-color cp_accent_fg {{ accent_fg }};
@define-color cp_red {{ red }};
@define-color cp_green {{ green }};
@define-color cp_yellow {{ yellow }};
@define-color cp_orange {{ orange }};
/* light-mode derived roles (static) */
@define-color cp_raised mix(@cp_view, @cp_chrome, 0.15);
@define-color cp_toolbar mix(@cp_chrome, @cp_view, 0.55);
@define-color cp_titlebar mix(@cp_chrome, @cp_view, 0.35);
@define-color cp_sidebar mix(@cp_chrome, @cp_fg, 0.035);
@define-color cp_menu_bg mix(@cp_view, @cp_chrome, 0.2);
@define-color cp_line alpha(@cp_fg, 0.13);
@define-color cp_line_strong alpha(@cp_fg, 0.24);
@define-color cp_hover alpha(@cp_fg, 0.06);
@define-color cp_pressed alpha(@cp_fg, 0.12);
@define-color cp_sel_soft alpha(@cp_fg, 0.10);
@define-color cp_field alpha(@cp_fg, 0.065);
@define-color cp_track alpha(@cp_fg, 0.16);
@define-color cp_text2 alpha(@cp_fg, 0.62);
@define-color cp_text3 alpha(@cp_fg, 0.40);
@define-color cp_hl rgba(255,255,255,0.85);
@define-color cp_shadow_s rgba(0,0,0,0.08);
@define-color cp_shadow_m rgba(0,0,0,0.16);
@define-color cp_shadow_l rgba(0,0,0,0.26);
@define-color cp_knob #ffffff;
@define-color cp_tip_bg #2b2b2e;
@define-color cp_tip_fg #f2f2f4;
@define-color cp_zebra alpha(@cp_fg, 0.028);
/* Carpathian "kylin" GTK3 style. GENERATED by gtktheme/tools/build-css.py from css/gtk3/generic.css.in + the style table; edit those, not this file.
   Layers on top of adw-gtk3. Only @cp_* roles are used for colour, so palette, accent and light/dark follow live. */

/* ---- window chrome ---- */
window, .background { background-color: @cp_chrome; color: @cp_fg; }
/* One border only: dwm draws the window border (and rounds the corners with XShape). GTK draws no outline, shadow, margin or corner of its own;
   inner lines exist only where they separate content (sidebar divider, bar-to-content line, status bar line). Checked by tests/borders.sh. */
window, window.background, window.csd, window.solid-csd, .background, decoration, decoration-overlay, window.csd decoration, window.solid-csd decoration,
decoration:backdrop, window.csd decoration:backdrop { border: none; border-radius: 0; box-shadow: none; outline: none; margin: 0; }
/* the decoration node also paints a padded frame in the theme (a 4 px grey band inside dwm's border): no padding, no background */
decoration, decoration-overlay, window.csd decoration, window.solid-csd decoration, decoration:backdrop, window.csd decoration:backdrop { padding: 0; border-width: 0; background: none; background-color: transparent; }
window:backdrop { color: @cp_text2; }
headerbar, .titlebar {
  min-height: 38px; padding: 0 12px; border: none; border-bottom: 1px solid @cp_line; border-radius: 0;
  background-image: none; background-color: @cp_chrome; color: @cp_fg; box-shadow: none; }
headerbar:backdrop, .titlebar:backdrop { background-color: @cp_toolbar; color: @cp_text2; }
headerbar .title, headerbar title { font-weight: 600; }
headerbar .subtitle { font-size: 90%; color: @cp_text2; }
headerbar button, headerbar entry, headerbar spinbutton { margin-top: 0; margin-bottom: 0; }
headerbar button.titlebutton { min-height: 22px; min-width: 22px; padding: 0; margin: 0 2px; border-radius: 999px; border: none; box-shadow: none;
  background-image: none; background-color: transparent; color: @cp_fg; }
headerbar button.titlebutton:hover { background-color: @cp_hover; }
headerbar button.titlebutton:active { background-color: @cp_pressed; }
headerbar button.titlebutton.close:hover { background-color: #e5484d; color: #fff; }

/* toolbars: unified with the title bar */
toolbar, .toolbar, .inline-toolbar, .primary-toolbar {
  background-color: @cp_chrome; background-image: none; border: none; border-bottom: 1px solid @cp_line; padding: 6px 10px; box-shadow: none; }
toolbar:backdrop { background-color: @cp_toolbar; }
toolbar separator { background-color: @cp_line; min-width: 1px; margin: 6px 6px; }
toolbar button, toolbar .toggle, toolbar toolbutton > button, toolbar toolbutton > button.toggle {
  min-height: 28px; min-width: 28px; padding: 2px 6px; border: none; border-radius: 6px; background-image: none; background-color: transparent; box-shadow: none; color: alpha(@cp_fg, 0.78); }
toolbar button:hover { background-color: @cp_hover; }
toolbar button:active, toolbar button:checked { background-color: @cp_pressed; color: @cp_fg; }
toolbar button:disabled { color: @cp_text3; }
menubar { background-color: @cp_chrome; padding: 2px 6px; border-bottom: 1px solid @cp_line; box-shadow: none; }
menubar > menuitem { padding: 3px 10px; border-radius: 6px; }
menubar > menuitem:hover { background-color: @cp_hover; }
statusbar { background-color: @cp_toolbar; color: @cp_text2; font-size: 92%; padding: 2px 10px; border-top: 1px solid @cp_line; min-height: 24px; }
statusbar > box { margin: 0; padding: 0; }
statusbar frame > border, statusbar frame { border: none; box-shadow: none; background: none; padding: 0; }

/* ---- buttons ---- */
button {
  min-height: 24px; min-width: 16px; padding: 3px 16px; border-radius: 6px; border: 1px solid transparent;
  background-image: none; background-color: alpha(@cp_fg, 0.07); color: @cp_fg;
  box-shadow: none; transition: background-color 90ms ease-out, box-shadow 90ms ease-out; text-shadow: none; -gtk-icon-shadow: none; }
button:hover { background-color: alpha(@cp_accent, 0.16); }
button:active, button:checked { background-color: alpha(@cp_accent, 0.28); box-shadow: none; }
button:disabled { color: @cp_text3; background-color: alpha(@cp_raised, 0.5); box-shadow: none; border-color: @cp_line; }
button:backdrop { color: @cp_text2; }
button.flat, button.image-button.flat, .flat button {
  background-color: transparent; border-color: transparent; box-shadow: none; }
button.flat:hover { background-color: @cp_hover; }
button.flat:active, button.flat:checked { background-color: @cp_pressed; }
button.image-button { min-width: 22px; padding: 3px 7px; }
button.circular, button.pill { border-radius: 999px; }
button.pill { padding: 5px 18px; }
button.suggested-action, button.suggested-action:hover, headerbar button.suggested-action {
  color: @cp_accent_fg; border-color: transparent; font-weight: 400;
  background-image: none; background-color: @cp_accent; box-shadow: none; }
button.suggested-action:hover { background-image: none; background-color: lighter(@cp_accent); }
button.suggested-action:active { background-image: none; background-color: darker(@cp_accent); box-shadow: none; }
button.destructive-action { color: @destructive_fg_color; border-color: alpha(black, 0.18); font-weight: 600;
  background-image: none; background-color: @cp_red; box-shadow: none; }
button.destructive-action:hover { background-image: none; background-color: lighter(@cp_red); }
button.link, button.link:hover { background: none; border: none; box-shadow: none; color: @cp_accent; padding: 0 2px; min-height: 0; }

/* linked groups and segmented controls */
.linked > button, .linked > button.toggle { border-radius: 0; margin-right: -1px; }
.linked:not(.vertical) > button:first-child, .linked:not(.vertical) > entry:first-child { border-top-left-radius: 6px; border-bottom-left-radius: 6px; }
.linked:not(.vertical) > button:last-child, .linked:not(.vertical) > entry:last-child { border-top-right-radius: 6px; border-bottom-right-radius: 6px; margin-right: 0; }
.linked:not(.vertical) > button:checked, .linked:not(.vertical) > button.toggle:checked {
  background-image: none; background-color: mix(@cp_raised, @cp_fg, 0.20); color: @cp_fg; box-shadow: inset 0 1px 2px @cp_shadow_s; }

/* ---- entries ---- */
entry, spinbutton {
  min-height: 24px; padding: 3px 9px; border-radius: 6px; border: 1px solid @cp_line_strong;
  background-image: none; background-color: @cp_view; color: @cp_fg; caret-color: @cp_fg;
  box-shadow: none; text-shadow: none; transition: box-shadow 120ms ease-out, border-color 120ms ease-out; }
entry:focus, spinbutton:focus-within { border-color: @cp_accent; box-shadow: 0 0 0 2px alpha(@cp_accent, 0.32); }
