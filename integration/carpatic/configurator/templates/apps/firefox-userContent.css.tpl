/* Generated by carpatic-retint ({{ @THEME }}): Firefox internal pages (new tab, about:*) */
@-moz-document url(about:home), url(about:newtab), url(about:blank), url-prefix(about:preferences), url-prefix(about:addons) {
  :root { --newtab-background-color: {{ background }} !important; --newtab-text-primary-color: {{ foreground }} !important; --in-content-page-background: {{ background }} !important; --in-content-page-color: {{ foreground }} !important; --in-content-primary-button-background: {{ accent }} !important; --in-content-primary-button-text-color: {{ accent_fg }} !important; --in-content-accent-color: {{ accent }} !important; }
  body { background-color: {{ background }} !important; color: {{ foreground }} !important; }
}
