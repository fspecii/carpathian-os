# Generated by carpatic-retint ({{ @THEME }}); sourced from your tmux.conf
set -g status-style "bg={{ dark_background }},fg={{ foreground }}"
set -g status-left "#[bg={{ accent }},fg={{ accent_fg }},bold] #S #[default] "
set -g status-right "#[fg={{ muted }}]%H:%M  #[fg={{ accent }}]#h "
set -g window-status-format " #I:#W "
set -g window-status-current-format "#[fg={{ accent }},bold] #I:#W "
set -g window-status-style "fg={{ light_foreground }}"
set -g message-style "bg={{ lighter_background }},fg={{ foreground }}"
set -g message-command-style "bg={{ lighter_background }},fg={{ accent }}"
set -g pane-border-style "fg={{ lighter_background }}"
set -g pane-active-border-style "fg={{ accent }}"
set -g mode-style "bg={{ selection_background }},fg={{ selection_foreground }}"
set -g display-panes-active-colour "{{ accent }}"
set -g display-panes-colour "{{ muted }}"
