# Generated by carpatic-theme ({{ @THEME }}). Edit via `carpatic-theme set`, not by hand.
[active]
theme = "carpatic"

[appearance]
border_width = {{ @BORDER_WIDTH }}
border_active = "{{ @BORDER_ACTIVE }}"      # empty = the theme accent
border_inactive = "{{ @BORDER_INACTIVE }}"
border_highlight = {{ @BORDER_HIGHLIGHT }}
smart_gaps = {{ @SMART_GAPS }}
drag_tiled = "{{ @DRAG_TILED }}"
corner_radius = {{ @CORNER_RADIUS }}
inner_gap = {{ @INNER_GAP }}
outer_gap = {{ @OUTER_GAP }}
# display scale in percent (Settings > Displays > Scale): dwm multiplies bar height, title bars, icons and tray by it and loads the bar font at that DPI
ui_scale = {{ @UI_SCALE }}
# default layout of every tag, applied live by dwm: "tile" or "float"
default_layout = "{{ @DEFLAYOUT }}"
# workspaces: how many (1-9) and optional names, comma separated (live)
workspaces = {{ @WORKSPACES }}
workspace_names = "{{ @WS_NAMES }}"

# window title bars + minimise/maximise/close buttons (real dwm keys, live reload; see desktop/PATCHES.md)
# dwm's native system tray: only with the built-in bar (tint2 profiles have their own tray)
[tray]
enabled = {{ @TRAY_INT }}

[titlebar]
enabled = {{ @TITLEBARS_INT }}
tiled = 1
floating = 1
buttons = 1
button_style = "{{ @BSTYLE }}"
button_side = "{{ @BSIDE }}"
buttons_shown = "{{ @BSHOWN }}"
title_align = "{{ @TALIGN }}"

[theme.carpatic]
normfgcolor     = "{{ light_foreground }}"
normbgcolor     = "{{ bar_bg }}"
normbordercolor = "{{ mix lighter_background muted 35 }}"
selfgcolor      = "{{ title_fg }}"
selbgcolor      = "{{ sel_tint }}"
selbordercolor  = "{{ accent }}"
term_bg         = "{{ background }}"
term_fg         = "{{ foreground }}"
term_cursor     = "{{ accent }}"
term_color0     = "{{ dark_background }}"
term_color1     = "{{ red }}"
term_color2     = "{{ green }}"
term_color3     = "{{ yellow }}"
term_color4     = "{{ blue }}"
term_color5     = "{{ magenta }}"
term_color6     = "{{ cyan }}"
term_color7     = "{{ foreground }}"
term_color8     = "{{ muted }}"
term_color9     = "{{ bright_red }}"
term_color10    = "{{ bright_green }}"
term_color11    = "{{ bright_yellow }}"
term_color12    = "{{ bright_blue }}"
term_color13    = "{{ bright_magenta }}"
term_color14    = "{{ bright_cyan }}"
term_color15    = "{{ bright_foreground }}"
dark_mode       = {{ @DARKMODE }}
