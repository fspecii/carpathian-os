/* Generated by carpatic-apply from the palette. Colour names follow design/tokens/out/gtk/colors-<mode>.css; widget polish is design/tokens/out/gtk/carpatic-widgets.css */
@define-color accent_color {{ accent }};
@define-color accent_bg_color {{ accent }};
@define-color accent_fg_color {{ accent_fg }};
@define-color destructive_color {{ red }};
@define-color destructive_bg_color {{ red }};
@define-color destructive_fg_color #2a0c0f;
@define-color success_color {{ green }};
@define-color success_bg_color {{ green }};
@define-color success_fg_color {{ darker_background }};
@define-color warning_color {{ yellow }};
@define-color warning_bg_color {{ yellow }};
@define-color warning_fg_color #2b2000;
@define-color error_color {{ red }};
@define-color error_bg_color {{ red }};
@define-color error_fg_color #2a0c0f;
@define-color window_bg_color {{ background }};
@define-color window_fg_color {{ foreground }};
@define-color view_bg_color {{ dark_background }};
@define-color view_fg_color {{ foreground }};
@define-color headerbar_bg_color {{ dark_background }};
@define-color headerbar_fg_color {{ foreground }};
@define-color headerbar_border_color {{ mix lighter_background muted 15 }};
@define-color headerbar_backdrop_color {{ background }};
@define-color card_bg_color {{ dark_background }};
@define-color card_fg_color {{ foreground }};
@define-color dialog_bg_color {{ dark_background }};
@define-color dialog_fg_color {{ foreground }};
@define-color popover_bg_color {{ lighter_background }};
@define-color popover_fg_color {{ foreground }};
@define-color sidebar_bg_color {{ dark_background }};
@define-color sidebar_fg_color {{ foreground }};
@define-color sidebar_backdrop_color {{ background }};
@define-color sidebar_border_color {{ mix lighter_background muted 15 }};
@define-color secondary_sidebar_bg_color {{ background }};
@define-color shade_color rgba(0,0,0,0.36);
@define-color scrollbar_outline_color {{ background }};
@define-color theme_bg_color {{ background }};
@define-color theme_fg_color {{ foreground }};
@define-color theme_base_color {{ dark_background }};
@define-color theme_text_color {{ foreground }};
@define-color theme_selected_bg_color {{ accent }};
@define-color theme_selected_fg_color {{ accent_fg }};
@define-color borders {{ mix lighter_background muted 35 }};
@define-color unfocused_borders {{ mix lighter_background muted 35 }};
/* Carpathian widget polish for GTK3 and GTK4. Import AFTER colors-<mode>.css.
   Radii/spacing come from tokens: sm=6 md=10 lg=14. Generated, do not edit. */
window, .background { font-family: "Inter", "Noto Sans", sans-serif; font-size: 14px; }
.monospace, textview.monospace, .terminal { font-family: "JetBrains Mono", monospace; }
button { border-radius: 6px; padding: 6px 14px; min-height: 20px; border: 1px solid @borders; background-image: none;
  background-color: @card_bg_color; color: @window_fg_color; box-shadow: none; transition: background-color 120ms cubic-bezier(0.2, 0, 0, 1); }
button:hover { background-color: alpha(@window_fg_color, 0.07); }
button:active, button:checked { background-color: alpha(@window_fg_color, 0.12); }
button.suggested-action { background-color: @accent_bg_color; color: @accent_fg_color; border-color: transparent; font-weight: 600; }
button.suggested-action:hover { background-color: shade(@accent_bg_color, 1.08); }
button.destructive-action { background-color: @destructive_bg_color; color: @destructive_fg_color; border-color: transparent; }
entry, spinbutton, textview { border-radius: 6px; border: 1px solid @borders; background-color: @view_bg_color; color: @view_fg_color; padding: 6px 10px; box-shadow: none; }
entry:focus, spinbutton:focus-within { border-color: @accent_bg_color; box-shadow: 0 0 0 2px alpha(@accent_bg_color, 0.35); }
headerbar, .titlebar { background-color: @headerbar_bg_color; color: @headerbar_fg_color; border-bottom: 1px solid @headerbar_border_color; box-shadow: none; min-height: 40px; }
.card, frame > border, list.boxed-list { border-radius: 10px; border: 1px solid @borders; background-color: @card_bg_color; box-shadow: none; }
popover > contents, menu, .menu { border-radius: 10px; border: 1px solid @borders; background-color: @popover_bg_color; }
menuitem, row, modelbutton { border-radius: 6px; }
row:selected, menuitem:hover, modelbutton:hover, treeview:selected { background-color: alpha(@accent_bg_color, 0.22); color: @window_fg_color; }
list.navigation-sidebar row:selected, .sidebar row:selected { background-color: alpha(@accent_bg_color, 0.22); }
switch { border-radius: 999px; background-color: alpha(@window_fg_color, 0.18); border: none; }
switch:checked { background-color: @accent_bg_color; }
switch slider { border-radius: 999px; background-color: #ffffff; }
scale trough, progressbar trough { border-radius: 999px; background-color: alpha(@window_fg_color, 0.14); min-height: 6px; }
scale highlight, progressbar progress { border-radius: 999px; background-color: @accent_bg_color; }
scrollbar slider { border-radius: 999px; min-width: 6px; min-height: 6px; background-color: alpha(@window_fg_color, 0.30); }
tooltip { border-radius: 6px; background-color: @popover_bg_color; color: @window_fg_color; border: 1px solid @borders; }
*:focus-visible { outline: 2px solid @accent_bg_color; outline-offset: 1px; }
