[font]
size = {{ @MONO_SZ }}
normal = { family = "{{ @MONO }}" }
[colors.primary]
background = "{{ background }}"
foreground = "{{ foreground }}"
[colors.cursor]
cursor = "{{ accent }}"
text = "{{ background }}"
[colors.normal]
black = "{{ dark_background }}"
red = "{{ red }}"
green = "{{ green }}"
yellow = "{{ yellow }}"
blue = "{{ blue }}"
magenta = "{{ magenta }}"
cyan = "{{ cyan }}"
white = "{{ foreground }}"
[colors.bright]
black = "{{ muted }}"
red = "{{ bright_red }}"
green = "{{ bright_green }}"
yellow = "{{ bright_yellow }}"
blue = "{{ bright_blue }}"
magenta = "{{ bright_magenta }}"
cyan = "{{ bright_cyan }}"
white = "{{ bright_foreground }}"
