<?xml version="1.0" encoding="UTF-8"?>
<!-- Carpathian defaults for Thunar (system-wide xfconf channel default: /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar.xml; user choices override) -->
<channel name="thunar" version="1.0">
  <property name="misc-symbolic-icons-in-toolbar" type="bool" value="true"/>
  <property name="misc-symbolic-icons-in-sidepane" type="bool" value="true"/>
  <property name="misc-small-toolbar-icons" type="bool" value="true"/>
  <property name="misc-use-csd" type="bool" value="false"/>
  <property name="misc-support-overlay-scrolling" type="bool" value="true"/>
  <property name="misc-folders-first" type="bool" value="true"/>
  <property name="misc-image-size-in-statusbar" type="bool" value="true"/>
  <property name="misc-thumbnail-mode" type="string" value="THUNAR_THUMBNAIL_MODE_ONLY_LOCAL"/>
  <property name="shortcuts-icon-size" type="string" value="THUNAR_ICON_SIZE_16"/>
  <property name="tree-icon-size" type="string" value="THUNAR_ICON_SIZE_16"/>
  <property name="shortcuts-disk-space-usage-bar" type="bool" value="true"/>
  <property name="last-menubar-visible" type="bool" value="false"/>
  <property name="last-statusbar-visible" type="bool" value="true"/>
  <property name="last-location-bar" type="string" value="ThunarLocationButtons"/>
</channel>
