#!/bin/sh
# carpatic-rollback: system snapshots and one-command rollback on Btrfs installs (the Carpathian installer default).
#
#   carpatic-rollback snapshot [label]   take a read-only snapshot of the system (not your home folder) and keep a copy of the boot files
#   carpatic-rollback list               show snapshots, newest first
#   carpatic-rollback restore <id>       make the system look like it did at <id> the next time you restart (a safety copy of "now" is kept)
#   carpatic-rollback delete <id>        remove a snapshot
#   carpatic-rollback prune [N]          keep the newest N automatic snapshots (default 8)
#
# Layout (matches installer/engine): subvolume "@" is "/", "@home" is /home, "/boot" is a separate FAT partition. Snapshots live in
# the "@snapshots" subvolume next to them. Your files in /home are never touched by a rollback.
# Why the boot files are copied: the kernel and initramfs sit on /boot (FAT, not snapshotted). Rolling the system back to an older
# kernel's modules while /boot holds a newer kernel would not boot, so we put the matching kernel back with it.
#
# Testing: CARPATIC_TOP=<dir> uses an already mounted top level of a Btrfs file system; CARPATIC_BOOT=<dir> overrides /boot.
# License: MIT. POSIX sh.
set -u
PATH="$PATH:/usr/local/sbin:/usr/sbin:/sbin"; export PATH
ROOTSUB=${CARPATIC_ROOTSUB:-@}
BOOT=${CARPATIC_BOOT:-/boot}
say() { printf '%s\n' "$*"; }
die() { printf 'carpatic-rollback: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || [ "${1:-}" = help ] || [ "${1:-}" = list ] || die "this needs administrator rights. Use: doas carpatic-rollback ${1:-help}"

MOUNTED=""; T=""
open_top() { # mount the top level of the root file system once; sets $T
  if [ -n "${CARPATIC_TOP:-}" ]; then T=$CARPATIC_TOP; return 0; fi
  [ -n "$T" ] && return 0
  fs=$(awk '$2=="/" {print $3}' /proc/mounts | tail -1)
  [ "$fs" = btrfs ] || die "snapshots need a Btrfs system disk. This system uses $fs. (Choose Btrfs in the installer to get rollback.)"
  dev=$(awk '$2=="/" && $3=="btrfs" {print $1}' /proc/mounts | tail -1)
  d=/run/carpatic/top; mkdir -p "$d"
  mount -o subvolid=5 "$dev" "$d" 2>/dev/null || die "could not open the disk's top level."
  MOUNTED=$d; T=$d
}
cleanup() { [ -n "$MOUNTED" ] && umount "$MOUNTED" 2>/dev/null; return 0; }
trap cleanup EXIT

slug() { printf '%s' "$1" | tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9._-' | cut -c1-40; }

do_snapshot() {
  label="${1:-manual}"; open_top
  [ -d "$T/$ROOTSUB" ] || die "no '$ROOTSUB' subvolume: this is not a Carpathian Btrfs layout."
  [ -d "$T/@snapshots" ] || btrfs subvolume create "$T/@snapshots" >/dev/null || die "could not create the snapshot area."
  sid="$(date +%Y%m%d-%H%M%S)-$(slug "$label")"
  n=1; base=$sid; while [ -e "$T/@snapshots/$sid" ]; do n=$((n+1)); sid="$base-$n"; done   # never snapshot "into" an existing one
  btrfs subvolume snapshot -r "$T/$ROOTSUB" "$T/@snapshots/$sid" >/dev/null || die "snapshot failed."
  mkdir -p "$T/@snapshots/$sid.boot"
  [ -d "$BOOT" ] && for f in "$BOOT"/vmlinuz-* "$BOOT"/initramfs-* "$BOOT"/*-ucode.img "$BOOT"/boot.conf "$BOOT"/limine.conf "$BOOT"/limine.cfg; do
    [ -f "$f" ] && cp -p "$f" "$T/@snapshots/$sid.boot/" 2>/dev/null
  done
  printf '%s\n' "$label" > "$T/@snapshots/$sid.label"
  say "Snapshot saved: $sid"
  do_menu
}

# ---- Limine boot menu: "Carpathian OS restore points" submenu with the newest few points, bootable even if the system will not start ----
MENU_KEEP=${CARPATIC_MENU_KEEP:-3}
INDEX=${CARPATIC_INDEX:-/var/lib/carpatic/restore-points}
write_index() { # world-readable list so the Settings window (not root) can show the restore points
  mkdir -p "$(dirname "$INDEX")" 2>/dev/null; do_list_raw > "$INDEX.new" 2>/dev/null && chmod 644 "$INDEX.new" && mv "$INDEX.new" "$INDEX"
}
do_menu() {
  open_top
  write_index
  confs=""; for c in "$BOOT/limine/limine.conf" "$BOOT/limine.conf"; do [ -f "$c" ] && confs="$confs $c"; done
  [ -n "$confs" ] || return 0                      # not a Limine system (or a test directory): nothing to do
  main=$(sed -n 's/^[[:space:]]*kernel_cmdline:[[:space:]]*//p' $confs | head -1)
  [ -n "$main" ] || return 0
  want=$(ls -1r "$T/@snapshots" 2>/dev/null | grep -v '\.boot$\|\.label$\|\.rw$\|^replaced-' | head -n "$MENU_KEEP")
  mkdir -p "$BOOT/snapshots"
  entries=""
  for sid in $want; do
    [ -d "$T/@snapshots/$sid.boot" ] && [ -f "$T/@snapshots/$sid.boot/vmlinuz-lts" ] || continue
    [ -d "$T/@snapshots/$sid.rw" ] || btrfs subvolume snapshot "$T/@snapshots/$sid" "$T/@snapshots/$sid.rw" >/dev/null 2>&1 || continue
    mkdir -p "$BOOT/snapshots/$sid"
    for f in "$T/@snapshots/$sid.boot"/vmlinuz-* "$T/@snapshots/$sid.boot"/initramfs-* "$T/@snapshots/$sid.boot"/*-ucode.img; do [ -f "$f" ] && cp -p "$f" "$BOOT/snapshots/$sid/" 2>/dev/null; done
    kernel=$(cd "$BOOT/snapshots/$sid" && ls vmlinuz-* | head -1); initrd=$(cd "$BOOT/snapshots/$sid" && ls initramfs-* | head -1)
    cmd=$(printf '%s' "$main" | sed "s|rootflags=subvol=@|rootflags=subvol=@snapshots/$sid.rw|; s| resume=[^ ]*||; s| resume_offset=[^ ]*||; s| single||")
    label=$(cat "$T/@snapshots/$sid.label" 2>/dev/null); d=$(printf '%s' "$sid" | sed 's/^\([0-9]\{4\}\)\([0-9]\{2\}\)\([0-9]\{2\}\)-\([0-9]\{2\}\)\([0-9]\{2\}\).*/\1-\2-\3 \4:\5/')
    entries="$entries
    //$d  ${label:-restore point}
        protocol: linux
        kernel_path: boot():/snapshots/$sid/$kernel
"
    for u in "$BOOT/snapshots/$sid"/*-ucode.img; do [ -f "$u" ] && entries="$entries        module_path: boot():/snapshots/$sid/$(basename "$u")
"; done
    entries="$entries        module_path: boot():/snapshots/$sid/$initrd
        kernel_cmdline: $cmd
"
  done
  for c in $confs; do
    sed -i '/^# >>> carpatic restore points/,/^# <<< carpatic restore points/d' "$c"
    if [ -n "$entries" ]; then
      { printf '\n# >>> carpatic restore points (generated by carpatic-rollback, do not edit)\n/Carpathian OS restore points\n'; printf '%s\n' "$entries"; printf '# <<< carpatic restore points\n'; } >> "$c"
    fi
  done
  # forget boot files and writable clones of points that fell out of the menu
  for d in "$BOOT"/snapshots/*; do [ -d "$d" ] || continue; b=$(basename "$d"); case " $(echo $want) " in *" $b "*) ;; *) rm -rf "${d:?}";; esac; done
  for r in $(ls -1 "$T/@snapshots" 2>/dev/null | grep '\.rw$'); do b=${r%.rw}; case " $(echo $want) " in *" $b "*) ;; *) btrfs subvolume delete "$T/@snapshots/$r" >/dev/null 2>&1;; esac; done
  return 0
}

do_list() {
  if [ "$(id -u)" != 0 ]; then [ -f "$INDEX" ] && cat "$INDEX" || say "No snapshots yet."; return 0; fi
  do_list_raw
}
do_list_raw() {
  open_top; found=0
  for s in $(ls -1r "$T/@snapshots" 2>/dev/null | grep -v '\.boot$\|\.label$\|\.rw$\|^replaced-'); do
    [ -d "$T/@snapshots/$s" ] || continue; found=1
    printf '%s  %s\n' "$s" "$(cat "$T/@snapshots/$s.label" 2>/dev/null)"
  done
  [ "$found" = 1 ] || say "No snapshots yet. Take one with: doas carpatic-rollback snapshot"
}

do_restore() {
  id="${1:-}"; [ -n "$id" ] || die "restore which snapshot? See: carpatic-rollback list"
  open_top
  [ -d "$T/@snapshots/$id" ] || die "no snapshot called '$id'."
  now="$(date +%Y%m%d-%H%M%S)-$$"
  # 1. safety copy of how the system is right now, so a rollback can itself be undone
  do_snapshot "before-rollback" >/dev/null
  # 2. the chosen snapshot becomes the new "@" (read-write), the old "@" is kept aside
  btrfs subvolume snapshot "$T/@snapshots/$id" "$T/@new-$now" >/dev/null || die "could not prepare the restored system."
  # nested subvolumes (the installer puts the swap file in "@/swap") are not part of a snapshot: carry them over to the restored system
  nested=$(btrfs subvolume list -o "$T/$ROOTSUB" 2>/dev/null | sed -n 's/.* path //p' | sed "s|^$ROOTSUB/||")
  for n in $nested; do
    [ -d "$T/$ROOTSUB/$n" ] || continue
    rmdir "$T/@new-$now/$n" 2>/dev/null
    mv "$T/$ROOTSUB/$n" "$T/@new-$now/$n" || { btrfs subvolume delete "$T/@new-$now" >/dev/null; die "could not keep '$n' (swap) with the restored system."; }
  done
  mv "$T/$ROOTSUB" "$T/@snapshots/replaced-$now" 2>/dev/null || { btrfs subvolume delete "$T/@new-$now" >/dev/null; die "could not move the current system aside."; }
  mv "$T/@new-$now" "$T/$ROOTSUB" || die "could not put the restored system in place. Boot from the live USB and rename @snapshots/replaced-$now back to $ROOTSUB."
  # 3. matching kernel and initramfs back on /boot
  if [ -d "$T/@snapshots/$id.boot" ] && [ -d "$BOOT" ]; then
    for f in "$T/@snapshots/$id.boot"/*; do [ -f "$f" ] && cp -p "$f" "$BOOT/" 2>/dev/null; done
  fi
  do_menu
  say "Done. Restart your computer to go back to '$id'."
  say "Your home folder was not changed. To undo this, restore the snapshot called 'before-rollback' the same way."
}

do_delete() {
  id="${1:-}"; [ -n "$id" ] || die "delete which snapshot?"
  open_top; [ -d "$T/@snapshots/$id" ] || die "no snapshot called '$id'."
  btrfs subvolume delete "$T/@snapshots/$id" >/dev/null || die "could not delete it."
  rm -rf "${T:?}/@snapshots/$id.boot"; rm -f "$T/@snapshots/$id.label"; btrfs subvolume delete "$T/@snapshots/$id.rw" >/dev/null 2>&1; do_menu; say "Deleted $id."
}

do_prune() {
  keep="${1:-8}"; open_top
  ls -1r "$T/@snapshots" 2>/dev/null | grep -v '\.boot$\|\.label$\|\.rw$\|^replaced-' | tail -n +"$((keep+1))" | while read -r s; do
    case "$s" in *-before-update-*|*-before-update) do_delete "$s" >/dev/null && echo "pruned $s";; esac
  done
  ls -1r "$T/@snapshots" 2>/dev/null | grep '^replaced-' | tail -n +3 | while read -r s; do btrfs subvolume delete "$T/@snapshots/$s" >/dev/null && echo "pruned $s"; done
  return 0
}

case "${1:-help}" in
  snapshot) shift; do_snapshot "$*";;
  list) do_list;; menu) do_menu;; restore) shift; do_restore "${1:-}";; delete) shift; do_delete "${1:-}";; prune) shift; do_prune "${1:-8}";;
  help|-h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//';;
  *) die "unknown command '$1' (try: carpatic-rollback help)";;
esac
