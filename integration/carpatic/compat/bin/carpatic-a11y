#!/bin/sh
# carpatic-a11y: accessibility switches for the Carpathian desktop. Used by the Accessibility page of Carpathian System and by the session.
#
#   carpatic-a11y status                         what is on
#   carpatic-a11y large-text on|off              bigger UI font, mono font and mouse pointer
#   carpatic-a11y high-contrast on|off           white-on-black theme with a yellow accent (contrast 21:1); "off" restores your theme
#   carpatic-a11y screen-reader on|off           Orca (speaks the interface, needs speech-dispatcher + espeak-ng)
#   carpatic-a11y keyboard on|off                on-screen keyboard (Onboard)
#   carpatic-a11y sticky|slow|bounce|mousekeys on|off
#                                                sticky keys (press modifiers one at a time), slow keys, bounce keys (ignore double
#                                                presses), keypad-moves-the-pointer
#   carpatic-a11y session                        apply everything saved (called at login)
#
# State lives in ~/.config/carpatic/a11y.env. License: MIT. POSIX sh (+ python3 for the X keyboard controls).
set -u
CFG="${XDG_CONFIG_HOME:-$HOME/.config}/carpatic"; ENV="$CFG/a11y.env"
mkdir -p "$CFG"; [ -f "$ENV" ] || : > "$ENV"
say() { printf '%s\n' "$*"; }
die() { printf 'carpatic-a11y: %s\n' "$*" >&2; exit 1; }
get() { sed -n "s/^$1=//p" "$ENV" | tail -1 | tr -d '"'; }
put() { grep -v "^$1=" "$ENV" > "$ENV.new" 2>/dev/null; printf '%s="%s"\n' "$1" "$2" >> "$ENV.new"; mv "$ENV.new" "$ENV"; }
del() { grep -v "^$1=" "$ENV" > "$ENV.new" 2>/dev/null; mv "$ENV.new" "$ENV"; }
onoff() { case "${1:-}" in on|off) :;; *) die "say 'on' or 'off' (example: carpatic-a11y $CMD on)";; esac; }
have() { command -v "$1" >/dev/null 2>&1; }

xkb() { # xkb <mask> on|off : change an AccessX control on the core keyboard
  [ -n "${DISPLAY:-}" ] || return 0
  python3 - "$1" "$2" <<'PY'
import ctypes, sys
mask = int(sys.argv[1]); on = sys.argv[2] == "on"
x = ctypes.CDLL("libX11.so.6")
x.XOpenDisplay.restype = ctypes.c_void_p
d = x.XOpenDisplay(None)
if not d: sys.exit(0)
a = [ctypes.c_int() for _ in range(5)]
x.XkbQueryExtension.argtypes = [ctypes.c_void_p] + [ctypes.c_void_p] * 5
a[3].value, a[4].value = 1, 0
x.XkbQueryExtension(d, *[ctypes.byref(i) for i in a])
x.XkbChangeEnabledControls.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint, ctypes.c_uint]
x.XkbChangeEnabledControls(d, 0x100, mask, mask if on else 0)
x.XFlush.argtypes = [ctypes.c_void_p]; x.XFlush(d)
PY
}
xkb_enabled() { # print the AccessX controls the X server really has on (bitmask), 0 when there is no display
  [ -n "${DISPLAY:-}" ] || { echo 0; return; }
  python3 - <<'PY'
import ctypes
x = ctypes.CDLL("libX11.so.6")
x.XOpenDisplay.restype = ctypes.c_void_p
d = x.XOpenDisplay(None)
if not d: print(0); raise SystemExit
a = [ctypes.c_int() for _ in range(5)]
x.XkbQueryExtension.argtypes = [ctypes.c_void_p] + [ctypes.c_void_p] * 5
a[3].value, a[4].value = 1, 0
x.XkbQueryExtension(d, *[ctypes.byref(i) for i in a])
x.XkbAllocKeyboard.restype = ctypes.c_void_p
x.XkbGetControls.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_void_p]
desc = x.XkbAllocKeyboard()
x.XkbGetControls(d, 0xF8001FFF, desc)      # XkbAllControlsMask
ctrls = ctypes.c_void_p.from_address(desc + 16).value
print(ctypes.c_uint.from_address(ctrls + 12).value)   # XkbControlsRec.enabled_ctrls
PY
}
mask_of() { case "$1" in slow) echo 2;; bounce) echo 4;; sticky) echo 8;; mousekeys) echo 16;; esac; }

proc_running() { ps | grep -v grep | grep -q "$1"; }

set_large() {
(
  have carpatic-appearance || die "the Appearance tools are not installed"
  umask 077
  large_snapshot="$CFG/large-text.snapshot"
  large_settings="${CARPATIC_CONFIG:-$HOME/.config/carpatic}/settings.conf"
  large_tmp=; large_lockdir=
  large_cleanup() {
    [ -z "$large_tmp" ] || rm -f "$large_tmp"
    [ -z "$large_lockdir" ] || rmdir "$large_lockdir" 2>/dev/null
    :
  }
  trap large_cleanup EXIT
  trap 'exit 1' INT TERM
  if have flock; then
    exec 9>"$CFG/large-text.lock" || die "cannot open the Large Text lock"
    flock -w 5 9 || die "Large Text is being changed; try again"
  else
    mkdir "$CFG/large-text.lock.d" 2>/dev/null || die "Large Text is being changed; try again"
    large_lockdir="$CFG/large-text.lock.d"
  fi
  large_validate() {
    awk -F= '
      $1 == "VERSION" { if (NF != 2 || ($2 != "1" && $2 != "2") || ++version != 1) bad=1; format=$2; next }
      $1 ~ /^(UI_SIZE|MONO_SIZE|CURSOR_SIZE)$/ {
        if (NF != 2 || ++seen[$1] != 1 || $2 !~ /^(absent|empty|default|[0-9]+)$/ || ($2 ~ /^[0-9]+$/ && ($2+0 < 1 || $2+0 > 4096))) bad=1; next
      }
      $1 ~ /^TARGET_(UI_SIZE|MONO_SIZE|CURSOR_SIZE)$/ {
        if (NF != 2 || ++seen[$1] != 1 || $2 !~ /^[0-9]+$/ || $2+0 < 1 || $2+0 > 4096) bad=1; next
      }
      { bad=1 }
      END { if (format == 2 && (seen["TARGET_UI_SIZE"] != 1 || seen["TARGET_MONO_SIZE"] != 1 || seen["TARGET_CURSOR_SIZE"] != 1)) bad=1;
        if (format == 1 && (seen["TARGET_UI_SIZE"] || seen["TARGET_MONO_SIZE"] || seen["TARGET_CURSOR_SIZE"])) bad=1;
        if (bad || version != 1 || seen["UI_SIZE"] != 1 || seen["MONO_SIZE"] != 1 || seen["CURSOR_SIZE"] != 1) exit 1 }
    ' "$large_snapshot"
  }
  large_state() {
    large_tmp=$(mktemp "$CFG/.large-text-state.XXXXXX") || return 1
    { awk '!/^LARGE_TEXT=/ && !/^LARGE_PREV=/' "$ENV" && printf 'LARGE_TEXT="%s"\n' "$1"; } >"$large_tmp" || return 1
    mv "$large_tmp" "$ENV" || return 1
    large_tmp=
  }
  # The legacy snapshot was computed, so it cannot recover historical absence.
  # Migrate only its three validated sizes; never source/eval the full string.
  large_legacy=$(get LARGE_PREV)
  if [ ! -e "$large_snapshot" ] && [ -n "$large_legacy" ]; then
    large_tmp=$(mktemp "$CFG/.large-text-snapshot.XXXXXX") || die "cannot save the original sizes"
    printf '%s\n' "$large_legacy" | awk '
      {
        # Old get output was collapsed into words with quotes removed. Recognize
        # assignment boundaries, never interpret shell syntax in font families.
        for (i=1;i<=NF;i++) {
          if ($i ~ /^[A-Z_]+=/) {
            key=$i; sub(/=.*/,"",key); value=$i; sub(/^[^=]*=/,"",value);
            if (++seen[key] != 1) bad=1; fields[key]=value
          } else if (key != "") fields[key]=fields[key]" "$i
        }
      }
      END {
        ui=fields["UI_SIZE"]; mono=fields["MONO_SIZE"]; cursor=fields["CURSOR_SIZE"];
        if (ui == "") { ui=fields["UI_FONT"]; sub(/^.* /,"",ui) }
        if (mono == "") { mono=fields["MONO_FONT"]; sub(/^.* /,"",mono) }
        if (ui !~ /^(default|[0-9]+)$/ || mono !~ /^(default|[0-9]+)$/ || cursor !~ /^(default|[0-9]+)$/) bad=1;
        if (!seen["UI_SIZE"] || !seen["MONO_SIZE"]) {
          scale=fields["SCALE"];
          if (scale !~ /^[0-9]+$/ || scale+0 < 100 || scale+0 > 300 || cursor !~ /^[0-9]+$/ || cursor+0 < 1 || cursor+0 > 4096) bad=1;
          else cursor=int((cursor*100+scale-1)/scale)
        }
        if (bad) exit 1;
        print "VERSION=1"; print "UI_SIZE="ui; print "MONO_SIZE="mono; print "CURSOR_SIZE="cursor
      }
    ' >"$large_tmp" || die "the saved legacy sizes are invalid; they were retained"
    mv "$large_tmp" "$large_snapshot" || die "cannot save the original sizes"
    large_tmp=
  fi
  if [ "$1" = on ] && [ ! -e "$large_snapshot" ]; then
    [ "$(get LARGE_TEXT)" != on ] || die "the original sizes are missing; cannot replace them with the current Large Text sizes"
    large_tmp=$(mktemp "$CFG/.large-text-snapshot.XXXXXX") || die "cannot save the original sizes"
    if [ -e "$large_settings" ]; then
      [ -f "$large_settings" ] && [ -r "$large_settings" ] || die "cannot read the original size settings"
      awk '
        /^(UI_SIZE|MONO_SIZE|CURSOR_SIZE)=/ {
          key=$0; sub(/=.*/,"",key); value=$0; sub(/^[^=]*=/,"",value)
          if (value ~ /^".*"$/) { sub(/^"/,"",value); sub(/"$/,"",value) }
          if (value == "") value="empty"
          if (value !~ /^(empty|default|[0-9]+)$/) bad=1
          values[key]=value; seen[key]=1
        }
        END { if (bad) exit 1; print "VERSION=1";
          print "UI_SIZE="(seen["UI_SIZE"] ? values["UI_SIZE"] : "absent");
          print "MONO_SIZE="(seen["MONO_SIZE"] ? values["MONO_SIZE"] : "absent");
          print "CURSOR_SIZE="(seen["CURSOR_SIZE"] ? values["CURSOR_SIZE"] : "absent") }
      ' "$large_settings" >"$large_tmp" || die "cannot capture valid original size settings"
    else
      printf 'VERSION=1\nUI_SIZE=absent\nMONO_SIZE=absent\nCURSOR_SIZE=absent\n' >"$large_tmp" || die "cannot save the original sizes"
    fi
    mv "$large_tmp" "$large_snapshot" || die "cannot save the original sizes"
    large_tmp=
  fi
  if [ ! -e "$large_snapshot" ]; then
    [ "$(get LARGE_TEXT)" != on ] || die "the original sizes are missing; current preferences were preserved"
    large_state off || die "cannot record the Large Text state"
    return 0
  fi
  [ -f "$large_snapshot" ] && large_validate || die "the saved original sizes are invalid; they were retained"
  if [ "$1" = on ]; then
    if [ "$(sed -n 's/^VERSION=//p' "$large_snapshot")" = 1 ]; then
      # appearance.get reports logical font sizes but physical cursor pixels.
      # Preserve originals independently. Add two font points / eight logical
      # cursor pixels once, with floors 14/13/40; repeated login never grows them.
      large_effective=$(carpatic-appearance get 9>&- 2>/dev/null) || die "cannot read effective sizes; saved originals were kept for retry"
      large_tmp=$(mktemp "$CFG/.large-text-snapshot.XXXXXX") || die "cannot save enlarged sizes"
      { printf '%s\n' "$large_effective"; printf '__ORIGINALS__\n'; cat "$large_snapshot"; } | awk '
        BEGIN { FS="=" }
        /^__ORIGINALS__$/ { originals=1; next }
        originals { if ($1 != "VERSION") saved[$1]=$2; next }
        $1 ~ /^(UI_FONT|MONO_FONT|CURSOR_SIZE|SCALE)$/ {
          if (++seen[$1] != 1) bad=1;
          value=substr($0,index($0,"=")+1); sub(/^"/,"",value); sub(/"$/,"",value);
          if ($1 ~ /_FONT$/) sub(/^.* /,"",value);
          if (value !~ /^[0-9]+$/ || value+0 < 1 || value+0 > 4096) bad=1;
          effective[$1]=value+0
        }
        END {
          if (bad || seen["UI_FONT"] != 1 || seen["MONO_FONT"] != 1 || seen["CURSOR_SIZE"] != 1 || seen["SCALE"] != 1 || effective["SCALE"] < 100 || effective["SCALE"] > 300) exit 1;
          keys[1]="UI_SIZE"; keys[2]="MONO_SIZE"; keys[3]="CURSOR_SIZE";
          baseline[1]=effective["UI_FONT"]; baseline[2]=effective["MONO_FONT"];
          baseline[3]=int((effective["CURSOR_SIZE"]*100+effective["SCALE"]-1)/effective["SCALE"]);
          floor[1]=14; floor[2]=13; floor[3]=40;
          for(i=1;i<=3;i++) {
            if (saved[keys[i]] ~ /^[0-9]+$/ && saved[keys[i]]+0 > baseline[i]) baseline[i]=saved[keys[i]]+0;
            if (baseline[i] < 1 || baseline[i] > 4088) exit 1;
            target[i]=baseline[i]+(i==3 ? 8 : 2); if (target[i]<floor[i]) target[i]=floor[i]
          }
          print "VERSION=2";
          for(i=1;i<=3;i++) print keys[i]"="saved[keys[i]];
          for(i=1;i<=3;i++) print "TARGET_"keys[i]"="target[i]
        }
      ' >"$large_tmp" || die "cannot capture valid effective sizes; saved originals were kept for retry"
      mv "$large_tmp" "$large_snapshot" || die "cannot save enlarged sizes; saved originals were kept for retry"
      large_tmp=
    fi
    large_ui=$(sed -n 's/^TARGET_UI_SIZE=//p' "$large_snapshot")
    large_mono=$(sed -n 's/^TARGET_MONO_SIZE=//p' "$large_snapshot")
    large_cursor=$(sed -n 's/^TARGET_CURSOR_SIZE=//p' "$large_snapshot")
    carpatic-appearance set ui-size "$large_ui" mono-size "$large_mono" cursor-size "$large_cursor" 9>&- >/dev/null 2>&1 || die "could not apply Large Text; size settings may already have changed. Saved originals were kept for retry"
    large_state on || die "could not record Large Text; size settings may already have changed. Saved originals were kept for retry"
  else
    large_ui=$(sed -n 's/^UI_SIZE=//p' "$large_snapshot")
    large_mono=$(sed -n 's/^MONO_SIZE=//p' "$large_snapshot")
    large_cursor=$(sed -n 's/^CURSOR_SIZE=//p' "$large_snapshot")
    case $large_ui in absent|empty) large_ui=default;; esac
    case $large_mono in absent|empty) large_mono=default;; esac
    case $large_cursor in absent|empty) large_cursor=default;; esac
    carpatic-appearance set ui-size "$large_ui" mono-size "$large_mono" cursor-size "$large_cursor" 9>&- >/dev/null 2>&1 || die "could not restore sizes; size settings may already have changed. Saved originals were kept for retry"
    # Appearance's default writes an empty override. Recover original presence
    # as well, filtering only these keys from the latest settings file.
    large_tmp=$(mktemp "${large_settings}.restore.XXXXXX") || die "cannot restore original overrides; saved originals were kept for retry"
    awk '!/^(UI_SIZE|MONO_SIZE|CURSOR_SIZE)=/' "$large_settings" >"$large_tmp" || die "cannot restore original overrides; saved originals were kept for retry"
    while IFS='=' read -r large_key large_value; do
      case $large_key in UI_SIZE|MONO_SIZE|CURSOR_SIZE)
        case $large_value in absent) continue;; empty) large_value=;; esac
        printf '%s="%s"\n' "$large_key" "$large_value" >>"$large_tmp" || die "cannot restore original overrides; saved originals were kept for retry"
      ;; esac
    done <"$large_snapshot"
    mv "$large_tmp" "$large_settings" || die "cannot restore original overrides; saved originals were kept for retry"
    large_tmp=
    large_state off || die "could not record restored sizes; saved originals were kept for retry"
    rm -f "$large_snapshot" || die "sizes restored but saved-state cleanup failed; try turning Large Text off again"
  fi
) || exit $?
}

set_contrast() {
  have carpatic-theme || die "the theme tools are not installed"
  if [ "$1" = on ]; then
    cur=$(carpatic-theme current 2>/dev/null)
    [ "$cur" = high-contrast ] || put CONTRAST_PREV "$cur"
    carpatic-theme set high-contrast >/dev/null 2>&1 || die "the high-contrast theme is not installed"
  else
    prev=$(get CONTRAST_PREV); carpatic-theme set "${prev:-carpatic}" >/dev/null 2>&1; del CONTRAST_PREV
  fi
  put HIGH_CONTRAST "$1"
}
set_reader() {
  if [ "$1" = on ]; then
    have orca || die "the screen reader (orca) is not installed. Install it with: doas apk add orca speech-dispatcher espeak-ng"
    proc_running "[o]rca" || { orca >/dev/null 2>&1 & }
  else pkill -x orca 2>/dev/null; pkill -f '/usr/bin/orca' 2>/dev/null; fi
  put SCREEN_READER "$1"
}
set_keyboard() {
  if [ "$1" = on ]; then
    have onboard || die "the on-screen keyboard (onboard) is not installed. Install it with: doas apk add onboard"
    proc_running "[o]nboard" || { onboard >/dev/null 2>&1 & }
  else pkill -f '/usr/bin/onboard' 2>/dev/null; fi
  put ONSCREEN_KEYBOARD "$1"
}

CMD=${1:-status}; [ $# -gt 0 ] && shift
case "$CMD" in
  status)
    for k in LARGE_TEXT HIGH_CONTRAST SCREEN_READER ONSCREEN_KEYBOARD; do
      printf '%-18s %s\n' "$(printf '%s' "$k" | tr 'A-Z_' 'a-z-')" "$(v=$(get $k); echo "${v:-off}")"; done
    en=$(xkb_enabled)
    for c in sticky slow bounce mousekeys; do
      m=$(mask_of "$c"); if [ $((en & m)) -ne 0 ]; then v=on; else v=off; fi; n="$c-keys"; [ "$c" = mousekeys ] && n=mouse-keys; printf '%-18s %s\n' "$n" "$v"; done;;
  large-text)    onoff "${1:-}"; set_large "$1";;
  high-contrast) onoff "${1:-}"; set_contrast "$1";;
  screen-reader) onoff "${1:-}"; set_reader "$1";;
  keyboard)      onoff "${1:-}"; set_keyboard "$1";;
  sticky|slow|bounce|mousekeys) onoff "${1:-}"; xkb "$(mask_of "$CMD")" "$1"; put "$(printf '%s' "$CMD" | tr a-z A-Z)" "$1";;
  session)
    for c in sticky slow bounce mousekeys; do v=$(get "$(printf '%s' "$c" | tr a-z A-Z)"); [ "$v" = on ] && xkb "$(mask_of "$c")" on; done
    [ "$(get SCREEN_READER)" = on ] && have orca && ! proc_running "[o]rca" && { orca >/dev/null 2>&1 & }
    [ "$(get ONSCREEN_KEYBOARD)" = on ] && have onboard && ! proc_running "[o]nboard" && { onboard >/dev/null 2>&1 & }
    ;;
  -h|--help|help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//';;
  *) die "unknown command '$CMD' (try: carpatic-a11y help)";;
esac
exit 0
