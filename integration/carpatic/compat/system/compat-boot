#!/bin/sh
# Boot-time preparation (idempotent). Installed as /usr/libexec/carpatic/compat-boot, run by the carpatic-compat OpenRC service.
# 1. rootless containers (carpatic-compat): tun, fuse, shared root mount
modprobe tun 2>/dev/null
modprobe fuse 2>/dev/null
mount --make-rshared / 2>/dev/null
# 2. remember package versions so carpatic-update can tell when a restart is needed
command -v carpatic-update >/dev/null 2>&1 && carpatic-update --baseline 2>/dev/null
exit 0
