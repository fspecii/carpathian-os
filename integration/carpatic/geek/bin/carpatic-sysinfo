#!/bin/sh
# carpatic-sysinfo: about this computer (carpatic system info), a check that every Carpathian tool is in place (doctor), the version.
# The look follows the terminal palette: ANSI cyan is the Carpathian accent, so the logo recolours with every theme.
#   carpatic-sysinfo            logo and facts
#   carpatic-sysinfo doctor     are the Carpathian tools all installed? exit 1 when something is missing
#   carpatic-sysinfo version
set -u
PATH="$(cd "$(dirname "$0")" && pwd):$PATH"
OSR=${CARPATIC_OS_RELEASE:-/etc/os-release}
val() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}$/\1/p" "$OSR" 2>/dev/null | head -1; }
VER=$(cat /usr/local/share/carpatic/VERSION 2>/dev/null || cat "$(dirname "$0")/../share/VERSION" 2>/dev/null || echo dev)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then A=$(printf '\033[36m'); W=$(printf '\033[37m'); B=$(printf '\033[1m'); D=$(printf '\033[2m'); E=$(printf '\033[33m'); R=$(printf '\033[0m'); else A=; W=; B=; D=; E=; R=; fi
CFG=${CARPATIC_CONFIG:-$HOME/.config/carpatic}
setting() { sed -n "s/^$1=\"\(.*\)\"$/\1/p" "$CFG/settings.conf" 2>/dev/null | tail -1; }

info() {
  host=$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo carpatic)
  up=$(awk '{s=int($1); d=int(s/86400); h=int(s%86400/3600); m=int(s%3600/60); if(d>0)printf "%dd ",d; if(h>0)printf "%dh ",h; printf "%dm",m}' /proc/uptime 2>/dev/null)
  mem=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%d MB of %d MB", (t-a)/1024, t/1024}' /proc/meminfo 2>/dev/null)
  cpu=$(sed -n 's/^model name[^:]*: *//p' /proc/cpuinfo 2>/dev/null | head -1)
  nproc_=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
  pk=$(apk info 2>/dev/null | wc -l | tr -d ' ')
  disk=$(df -h / 2>/dev/null | awk 'NR==2{printf "%s of %s (%s)", $3, $2, $5}')
  prof=$(setting PROFILE); th=$(setting THEME)
  scr=$(xdotool getdisplaygeometry 2>/dev/null | tr ' ' x)
  bat=; for b in /sys/class/power_supply/BAT*; do [ -r "$b/capacity" ] && bat="$(cat "$b/capacity")% ($(cat "$b/status" 2>/dev/null))" && break; done
  gpu=$(lspci 2>/dev/null | sed -n 's/.*\(VGA compatible controller\|3D controller\): *//p' | head -1 | cut -c1-60)
  sh_=$(basename "${SHELL:-sh}")
  row() { [ -n "$2" ] && printf '%s%-9s%s %s\n' "$A" "$1" "$R" "$2"; }
  {
    printf '%s%s%s@%s%s\n' "$B" "$(id -un)" "$R" "$B$host" "$R"
    printf '%s\n' "$(printf '%s' "$(id -un)@$host" | sed 's/./-/g')"
    row OS "Carpathian OS $VER (Alpine $(val VERSION_ID), musl)"
    row Kernel "$(uname -r)"
    row Uptime "$up"
    [ "${pk:-0}" -gt 0 ] && row Packages "$pk (apk)"
    row Shell "$sh_"
    row Desktop "dwm, ${prof:-tiling} style, theme ${th:-carpatic}"
    row Screen "$scr"
    row CPU "$cpu${nproc_:+ ($nproc_)}"
    row GPU "$gpu"
    row Memory "$mem"
    row Disk "$disk"
    row Battery "$bat"
  } > "${TMPDIR:-/tmp}/carpatic-sysinfo.$$"
  # plain logo lines, padded to one width, tinted per line (snow cap white, rock accent, sun yellow)
  awk -v A="$A" -v W="$W" -v E="$E" -v R="$R" 'NR==FNR { info[NR]=$0; n=NR; next }
    { line=sprintf("%-27s", $0); c=(FNR<=3)?W:A; sub(/o/, E "o" c, line); right=(FNR<=n)?info[FNR]:""; printf "%s%s%s %s\n", c, line, R, right }
    END { for (i=FNR+1; i<=n; i++) printf "%27s %s\n", "", info[i] }' "${TMPDIR:-/tmp}/carpatic-sysinfo.$$" - <<'L'
         .
        /#\
       /###\    o
      /#####\   /\
   /\/#######\_/##\
  /###\#########\###\
 /#####\#########\####\
/#######\#########\#####\
L
  rm -f "${TMPDIR:-/tmp}/carpatic-sysinfo.$$"
}

doctor() {
  miss=0; total=0
  chk() { total=$((total+1)); if command -v "$2" >/dev/null 2>&1; then printf '  %sok%s       %s\n' "$A" "$R" "$1"; else printf '  %smissing%s  %s (%s)\n' "$E" "$R" "$1" "$2"; miss=$((miss+1)); fi; }
  echo "Carpathian tools on this computer"
  chk "carpatic command" carpatic
  chk "menu" carpatic-menu
  chk "keyboard shortcut sheet" carpatic-cheatsheet
  chk "themes and Omarchy import" carpatic-themepack
  chk "dev environments" carpatic-dev
  chk "web apps" carpatic-webapp
  chk "terminal apps" carpatic-tui
  chk "hooks" carpatic-hook
  chk "dotfiles" carpatic-dotfiles
  chk "capture and share" carpatic-trigger
  chk "theme tool" carpatic-theme
  chk "profile tool" carpatic-profile
  chk "appearance tool" carpatic-appearance
  chk "store" carpatic-store
  chk "AI tools" carpatic-ai
  chk "drivers" carpatic-drivers
  chk "power" carpatic-power
  chk "updates" carpatic-update
  chk "rollback" carpatic-rollback
  chk "compatibility box" carpatic-compat
  echo "Helpers the menu uses"
  chk "launcher" rofi
  chk "screenshots" maim
  chk "clipboard" xclip
  chk "clipboard history helper" carpatic-clipwatch
  echo
  if [ $miss -eq 0 ]; then echo "Everything is in place."; else echo "$miss of $total are missing. The commands that need them say what to install."; fi
  [ $miss -eq 0 ]
}

case ${1:-info} in
  info|"") info ;;
  doctor) doctor ;;
  version|--version) echo "Carpathian OS $VER" ;;
  -h|--help|help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "carpatic system: I do not know '$1'. Try: info, doctor, version." >&2; exit 2 ;;
esac
