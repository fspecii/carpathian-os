#!/usr/bin/env python3
"""Carpatic Settings: the system settings app (GTK3). Usage: carpatic-settings [page] [--page NAME] [--anchor ROW]
Deep links: wifi bluetooth network notifications sound appearance accessibility desktop wallpaper displays battery lock keyboard mouse
trackpad printers users language datetime privacy updates apps storage about general; old names (style colours fonts icons cursors
wallpapers touchpad display startup widgets) still work. Test options: --shot FILE (render the window and quit), --theme NAME, --size WxH."""
import os, sys
os.environ["GDK_BACKEND"] = "x11"   # Carpatic is an X11 desktop; never attach to a Wayland session
os.environ.pop("WAYLAND_DISPLAY", None)
HERE = os.path.dirname(os.path.realpath(__file__))
if HERE not in os.environ.get("PATH", "").split(":"): os.environ["PATH"] = os.environ.get("PATH", "") + ":" + HERE   # carpatic-mouse, -keyboard, ... next to this file
for p in (HERE, os.path.join(HERE, "..", "lib"), "/usr/local/lib/carpatic-settings", "/usr/lib/carpatic-settings", "/usr/lib/carpatic", os.path.join(HERE, "..", "..", "configurator", "lib"), "/usr/local/lib/carpatic"):
    if os.path.isdir(p) and p not in sys.path: sys.path.insert(0, p)
try:                                  # follow the display scale (configurator/lib/carpatic_scale.py); idempotent, a no-op at 100%
    import carpatic_scale; carpatic_scale.install()
except Exception: pass
from cset.main import main
sys.exit(main(sys.argv[1:]))
