#!/usr/bin/env python3
"""Open Carpathian Notes on demand in the desktop session."""
import os
import sys
from pathlib import Path

if os.environ.get('WAYLAND_DISPLAY') or not os.environ.get('DISPLAY'):
    raise SystemExit('Open Notes from your Carpathian X11 desktop.')
os.environ['GDK_BACKEND'] = 'x11'
for location in (Path(__file__).resolve().parents[1] / 'lib', Path('/usr/local/lib/carpatic-notes')):
    if location.is_dir():
        sys.path.insert(0, str(location))
from carpatic_notes.app import main
raise SystemExit(main())
