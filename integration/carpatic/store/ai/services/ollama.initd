#!/sbin/openrc-run
# Carpatic: OpenRC service for Ollama (the Alpine package ships none).
description="Ollama local LLM server"
command=/usr/bin/ollama
command_args="serve"
command_user="ollama:ollama"
supervisor="supervise-daemon"
output_logger="logger -t ollama -p daemon.info"
error_logger="logger -t ollama -p daemon.info"
: ${OLLAMA_HOST:=127.0.0.1:11434}
: ${OLLAMA_MODELS:=/var/lib/ollama/models}
export OLLAMA_HOST OLLAMA_MODELS HOME=/var/lib/ollama
depend() { need net; }
start_pre() { checkpath -d -o ollama:ollama -m 0750 /var/lib/ollama /var/lib/ollama/models; }
