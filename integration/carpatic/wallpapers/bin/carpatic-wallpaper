#!/usr/bin/env python3
import os, sys
here = os.path.dirname(os.path.realpath(__file__))
for d in (os.path.join(here, "..", "lib"), "/usr/local/share/carpatic/wallpapers/lib"):
    if os.path.isdir(os.path.join(d, "carpatic_wallpapers")): sys.path.insert(0, d); break
from carpatic_wallpapers.cli import main
sys.exit(main())
