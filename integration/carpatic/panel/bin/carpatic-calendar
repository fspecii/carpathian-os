#!/usr/bin/env python3
"""Open selected calendar event details without launching a terminal."""
import argparse, datetime as dt, os, sys, select, subprocess
here = os.path.dirname(os.path.abspath(__file__))
for path in ('/usr/local/lib/carpatic-panel', os.path.join(here, '..', 'lib')):
    if os.path.isdir(path): sys.path.insert(0, path)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--event', required=True); parser.add_argument('--uid', default='')
parser.add_argument('--title', default='Calendar event'); parser.add_argument('--date', required=True)
parser.add_argument('--start'); parser.add_argument('--end'); parser.add_argument('--all-day', action='store_true')
parser.add_argument('--wait-for-launch', action='store_true', help=argparse.SUPPRESS)
args = parser.parse_args()
try:
    selection = dict(path=args.event, uid=args.uid, title=args.title, day=dt.date.fromisoformat(args.date),
        start=dt.time.fromisoformat(args.start) if args.start else None,
        end=dt.time.fromisoformat(args.end) if args.end else None, all_day=args.all_day)
except ValueError: parser.error('Invalid selected event date or time')
if args.wait_for_launch:
    ready, _, _ = select.select([sys.stdin.buffer], [], [], 5)
    if not ready or sys.stdin.buffer.read(1) != b'1':
        raise SystemExit(1)
try:
    from carpatic_panel.calendar_editor import run
    result = run(selection)
except Exception:
    try:
        subprocess.run(['notify-send', 'Calendar', 'The calendar editor could not start. Open Calendar and try again.'],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=3, check=False)
    except (OSError, subprocess.TimeoutExpired): pass
    raise SystemExit(1)
raise SystemExit(result)
